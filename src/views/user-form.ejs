<% const isEdit = typeof user !== 'undefined' && user !== null; %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/users" class="text-blue-600 text-sm hover:underline flex items-center gap-1">
        <i class="fas fa-arrow-left text-xs"></i> Voltar para usuários
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-2">
        <%= isEdit ? 'Editar Usuário' : 'Cadastrar Novo Usuário' %>
      </h1>
    </div>
  </div>

  <form 
    action="<%= isEdit ? '/users/update/' + user.id : '/users/create' %>" 
    method="POST" 
    class="bg-white p-8 rounded-xl shadow-sm border border-slate-200 space-y-5"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Foto -->
    <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1">URL da Foto de Perfil</label>
      <input
        type="url"
        name="avatarUrl"
        value="<%= isEdit && user.avatarUrl ? user.avatarUrl : '' %>"
        placeholder="https://exemplo.com/minha-foto.jpg"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500"
      />
    </div>    

    <!-- Nome -->
    <div>
      <label class="block text-xs font-bold uppercase text-slate-600 mb-2">Nome Completo</label>
      <input 
        name="name" 
        type="text" 
        value="<%= isEdit ? user.name : '' %>" 
        placeholder="Ex: João da Silva" 
        class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm text-slate-800" 
        required
      >
    </div>

    <!-- E-mail e Telefone (WhatsApp) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-2">E-mail</label>
        <input 
          name="email" 
          type="email" 
          value="<%= isEdit ? (user.email || '') : '' %>" 
          placeholder="cliente@exemplo.com" 
          class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm text-slate-800"
        >
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-2">WhatsApp / Telefone</label>
        <input 
          name="phone" 
          type="text" 
          value="<%= isEdit ? (user.phone || '') : '' %>" 
          placeholder="Ex: 5521999998888" 
          class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm text-slate-800"
        >
      </div>
    </div>

    <!-- Telegram ID e Função (Role) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-2">Telegram ID</label>
        <input 
          name="telegramId" 
          type="text" 
          value="<%= isEdit ? (user.telegramId || '') : '' %>" 
          placeholder="Ex: 1218571836" 
          class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm text-slate-800"
        >
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-2">Função / Permissão</label>
        <select 
          name="role" 
          class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white text-sm text-slate-800 font-semibold"
        >
          <option value="USER" <%= (isEdit && user.role === 'USER') ? 'selected' : '' %>>USER (Cliente Comum)</option>
          <option value="ADMIN" <%= (isEdit && user.role === 'ADMIN') ? 'selected' : '' %>>ADMIN (Acesso a Tools Administrativas)</option>
        </select>
      </div>
    </div>

    <!-- Tenant -->
    <div>
      <label class="block text-xs font-bold uppercase text-slate-600 mb-2">Tenant (Empresa)</label>
      <select 
        name="tenantId" 
        class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white text-sm text-slate-800"
      >
        <% tenants.forEach(t => { %>
          <option value="<%= t.id %>" <%= (isEdit && user.tenantId === t.id) ? 'selected' : '' %>>
            <%= t.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <!-- Botão de Salvar -->
    <button 
      type="submit" 
      class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg transition shadow-md flex items-center justify-center gap-2 text-sm mt-4"
    >
      <i class="fas fa-save"></i>
      <%= isEdit ? 'Salvar Alterações' : 'Cadastrar Usuário' %>
    </button>
  </form>
</div>
