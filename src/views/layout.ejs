<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof brand !== 'undefined' && brand.name) ? brand.name : 'TechnoShopping' %> | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html { scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    <div class="flex min-h-screen">

        <aside class="w-64 bg-slate-900 text-slate-300 shadow-xl flex flex-col">
            <!-- HEADER DA SIDEBAR: LOGO + NOME DA MARCA -->
            <div class="p-6 text-xl font-bold flex items-center gap-3 border-b border-slate-800 text-white">
                <img
                    src="/assets/logo.jpg"
                    alt="TechnoShopping Logo"
                    class="w-9 h-9 rounded-lg object-cover bg-blue-600 p-0.5 shadow-sm"
                    onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=TS&background=2563eb&color=fff&bold=true';"
                />
                <span class="truncate">TechnoShopping</span>
            </div>

            <nav class="p-4 flex-1 space-y-1">
                <p class="px-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-2">Principal</p>

                <a href="/dashboard" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-chart-line mr-3 text-slate-500 group-hover:text-blue-400"></i> Dashboard
                </a>

                <p class="px-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider mt-6 mb-2">Gestão</p>

                <a href="/tenants" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-building mr-3 text-slate-500 group-hover:text-blue-400"></i> Tenants
                </a>

                <a href="/products" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-box mr-3 text-slate-500 group-hover:text-blue-400"></i> Produtos
                </a>

                <a href="/users" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-users mr-3 text-slate-500 group-hover:text-blue-400"></i> Usuários
                </a>

                <a href="/orders" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-shopping-cart mr-3 text-slate-500 group-hover:text-blue-400"></i> Pedidos
                </a>

                <a href="/dashboard/drivers" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-motorcycle mr-3 text-slate-500 group-hover:text-blue-400"></i> Entregadores
                </a>

                <a href="/dashboard/tracking" class="flex items-center p-3 rounded-lg hover:bg-slate-800 hover:text-white transition-all group">
                    <i class="fas fa-map-marker-alt mr-3 text-slate-500 group-hover:text-blue-400"></i> Rastreio GPS
                </a>

            </nav>

            <div class="p-4 border-t border-slate-800 text-[10px] text-slate-500 text-center">
                v1.0.4 - Ubuntu Server
            </div>
        </aside>

        <main class="flex-1 flex flex-col">
            <header class="bg-white shadow-sm border-b border-slate-200 p-4 flex justify-between items-center px-8">
                <div class="text-slate-400">
                    <span class="text-xs uppercase font-bold tracking-widest">Painel de Controle</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right">
                        <p class="text-sm font-bold leading-none"><%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Administrador' %></p>
                        <p class="text-[10px] text-green-500 font-medium italic">Online</p>
                    </div>

                    <!-- Avatar Dinâmico -->
                    <% if (typeof user !== 'undefined' && user && user.avatarUrl) { %>
                        <img
                            src="<%= user.avatarUrl %>"
                            alt="Avatar"
                            class="w-10 h-10 rounded-full object-cover border-2 border-blue-100 shadow-sm"
                            onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name || 'Admin') %>&background=2563eb&color=fff';"
                        />
                    <% } else { %>
                        <div class="w-10 h-10 rounded-full bg-blue-600 border-2 border-blue-100 flex items-center justify-center text-white shadow-inner font-bold">
                            <%= (typeof user !== 'undefined' && user && user.name) ? user.name.charAt(0).toUpperCase() : 'A' %>
                        </div>
                    <% } %>

                    <form
                        method="POST"
                        action="/logout"
                    >
                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        >

                        <button
                            type="submit"
                            title="Sair"
                            class="flex items-center gap-2 px-3 py-2 text-sm text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition"
                        >
                            <i class="fas fa-right-from-bracket"></i>
                            <span>Sair</span>
                        </button>
                    </form>
                </div>
            </header>

            <div class="p-8 flex-1 overflow-y-auto">
                <%- body %>
            </div>
        </main>
    </div>
</body>
</html>
