<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Gerenciamento de Pedidos</h1>
        <p class="text-xs text-slate-500 mt-1">Pedidos integrados com os agentes de IA, checkout e rastreamento.</p>
    </div>
    <a href="/orders/new" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-all shadow-md flex items-center gap-2 text-sm">
        <i class="fas fa-cart-plus"></i> Novo Pedido
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden border border-slate-200">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">ID / Data</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Cliente</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Itens</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status Pedido</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Pagamento</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Envio & Rastreio</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Total</th>
                    <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                    <% orders.forEach(order => { %>
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="p-4">
                                <div class="font-mono text-xs text-blue-600 font-bold uppercase">
                                    #<%= order.id.slice(-8).toUpperCase() %>
                                </div>
                                <div class="text-[10px] text-slate-400 mt-0.5">
                                    <%= new Date(order.createdAt).toLocaleDateString('pt-BR') %>
                                </div>
                            </td>

                            <td class="p-4 text-slate-700 font-medium text-sm">
                                <%= order.user ? order.user.name : 'N/A' %>
                            </td>

                            <td class="p-4 text-xs text-slate-600 max-w-[200px]">
                                <% if (order.items && order.items.length > 0) { %>
                                    <div class="space-y-1">
                                        <% order.items.forEach(item => { %>
                                            <div class="truncate">
                                                <span class="font-bold text-slate-800"><%= item.quantity %>x</span> 
                                                <%= item.productName || (item.product ? item.product.name : 'Item') %>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-400 italic">Sem itens</span>
                                <% } %>
                            </td>

                            <td class="p-4">
                                <%
                                    let statusClass = "bg-slate-100 text-slate-600 border-slate-200";
                                    if (order.status === 'PAID') statusClass = "bg-blue-50 text-blue-700 border-blue-200";
                                    if (order.status === 'PROCESSING') statusClass = "bg-amber-50 text-amber-700 border-amber-200";
                                    if (order.status === 'SHIPPED') statusClass = "bg-purple-50 text-purple-700 border-purple-200";
                                    if (order.status === 'DELIVERED') statusClass = "bg-emerald-50 text-emerald-700 border-emerald-200";
                                    if (order.status === 'CANCELLED' || order.status === 'REFUNDED') statusClass = "bg-rose-50 text-rose-700 border-rose-200";
                                %>
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide border <%= statusClass %>">
                                    <%= order.status %>
                                </span>
                            </td>

                            <td class="p-4">
                                <%
                                    let payClass = "bg-amber-50 text-amber-700 border-amber-200";
                                    if (order.paymentStatus === 'PAID') payClass = "bg-emerald-50 text-emerald-700 border-emerald-200";
                                    if (order.paymentStatus === 'FAILED' || order.paymentStatus === 'CANCELLED' || order.paymentStatus === 'REFUNDED') payClass = "bg-rose-50 text-rose-700 border-rose-200";
                                %>
                                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border <%= payClass %>">
                                    <%= order.paymentStatus %>
                                </span>
                                <% if (order.paidAt) { %>
                                    <div class="text-[10px] text-slate-400 mt-0.5">
                                        <%= new Date(order.paidAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                <% } %>
                            </td>

                            <td class="p-4 text-xs">
                                <% if (order.trackingCode) { %>
                                    <div class="font-mono font-bold text-slate-700"><%= order.trackingCode %></div>
                                    <div class="text-[10px] text-slate-400"><%= order.carrier || 'Correios' %></div>
                                <% } else { %>
                                    <span class="text-slate-400 italic text-[11px]">Não postado</span>
                                <% } %>
                            </td>

                            <td class="p-4 font-bold text-slate-800 text-sm">
                                R$ <%= Number(order.total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                            </td>

                            <td class="p-4 text-center">
                                <div class="flex justify-center items-center gap-2">
                                    <a href="/orders/view/<%= order.id %>" class="p-2 text-slate-400 hover:text-blue-600 transition-colors" title="Ver Detalhes">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/orders/print/<%= order.id %>" target="_blank" class="p-2 text-slate-400 hover:text-green-600 transition-colors" title="Imprimir Recibo">
                                        <i class="fas fa-print"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="p-8 text-center text-slate-400 text-sm">
                            Nenhum pedido cadastrado.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
