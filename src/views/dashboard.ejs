<div class="space-y-6">
  <!-- Cabeçalho com Status do Gateway -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Visão Geral da Operação</h1>
      <p class="text-xs text-slate-500 mt-1">Métricas em tempo real de vendas, agentes de IA e instâncias.</p>
    </div>
    <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-200 text-emerald-700 px-3 py-1.5 rounded-full text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      OpenClaw Gateway Online
    </div>
  </div>

  <!-- Cards / KPIs -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <!-- Faturamento Pago -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Faturamento (Pago)</p>
        <h3 class="text-2xl font-bold text-slate-800 mt-1">
          R$ <%= (typeof revenue !== 'undefined' ? revenue : 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
        </h3>
        <p class="text-[11px] text-emerald-600 font-medium mt-1">
          <i class="fas fa-arrow-trend-up mr-1"></i> Pedidos Liquidados
        </p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
        <i class="fas fa-dollar-sign"></i>
      </div>
    </div>

    <!-- Total de Pedidos -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total de Pedidos</p>
        <h3 class="text-2xl font-bold text-slate-800 mt-1"><%= typeof ordersCount !== 'undefined' ? ordersCount : 0 %></h3>
        <p class="text-[11px] text-indigo-600 font-medium mt-1">
          <i class="fas fa-shopping-cart mr-1"></i> IA & Manuais
        </p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
        <i class="fas fa-box"></i>
      </div>
    </div>

    <!-- Produtos Cadastrados -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Produtos Ativos</p>
        <h3 class="text-2xl font-bold text-slate-800 mt-1"><%= productsCount %></h3>
        <p class="text-[11px] text-slate-500 font-medium mt-1">Integrados nas Tools</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
        <i class="fas fa-shopping-bag"></i>
      </div>
    </div>

    <!-- Usuários e Tenants -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tenants / Usuários</p>
        <h3 class="text-2xl font-bold text-slate-800 mt-1"><%= tenantsCount %> <span class="text-base text-slate-400 font-normal">/ <%= usersCount %></span></h3>
        <p class="text-[11px] text-purple-600 font-medium mt-1">Instâncias Ativas</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
        <i class="fas fa-building"></i>
      </div>
    </div>

  </div>

  <!-- Monitor de Agentes + Tabela de Pedidos Recentes -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Cluster de IA (1 Coluna) -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <h3 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
          <i class="fas fa-robot text-indigo-600"></i> Cluster de Agentes
        </h3>
        <div class="space-y-2.5 text-sm">
          <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg">
            <span class="font-medium text-slate-700 text-xs">Sales (Vendas)</span>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-100/60 px-2 py-0.5 rounded">ONLINE</span>
          </div>
          <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg">
            <span class="font-medium text-slate-700 text-xs">Product (Catálogo)</span>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-100/60 px-2 py-0.5 rounded">ONLINE</span>
          </div>
          <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg">
            <span class="font-medium text-slate-700 text-xs">Support (Tracking)</span>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-100/60 px-2 py-0.5 rounded">ONLINE</span>
          </div>
          <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg">
            <span class="font-medium text-slate-700 text-xs">AI Data (Memória)</span>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-100/60 px-2 py-0.5 rounded">ONLINE</span>
          </div>
          <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg">
            <span class="font-medium text-slate-700 text-xs">Fallback Handler</span>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-100/60 px-2 py-0.5 rounded">ONLINE</span>
          </div>
        </div>
      </div>
      
      <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span>Provider: <strong>OpenClaw</strong></span>
        <a href="/tenants" class="text-indigo-600 font-semibold hover:underline">Limites →</a>
      </div>
    </div>

    <!-- Pedidos Recentes (2 Colunas) -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm lg:col-span-2">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-slate-800">Últimos Pedidos</h3>
        <a href="/orders" class="text-xs font-semibold text-blue-600 hover:underline">Ver Todos</a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-slate-100 text-slate-400 uppercase tracking-wider font-semibold">
              <th class="py-2.5">ID / Data</th>
              <th class="py-2.5">Cliente</th>
              <th class="py-2.5">Status</th>
              <th class="py-2.5">Pagamento</th>
              <th class="py-2.5 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (typeof recentOrders !== 'undefined' && recentOrders.length > 0) { %>
              <% recentOrders.forEach(order => { %>
                <tr class="hover:bg-slate-50/70 transition">
                  <td class="py-3">
                    <span class="font-mono font-bold text-blue-600">#<%= order.id.slice(-6).toUpperCase() %></span>
                    <span class="block text-[10px] text-slate-400"><%= new Date(order.createdAt).toLocaleDateString('pt-BR') %></span>
                  </td>
                  <td class="py-3 font-medium text-slate-700"><%= order.user ? order.user.name : 'N/A' %></td>
                  <td class="py-3">
                    <span class="px-2 py-0.5 rounded font-semibold text-[10px] 
                      <%= order.status === 'SHIPPED' ? 'bg-purple-50 text-purple-700' : 
                          order.status === 'DELIVERED' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
                      <%= order.status %>
                    </span>
                  </td>
                  <td class="py-3">
                    <span class="px-1.5 py-0.5 rounded text-[10px] <%= order.paymentStatus === 'PAID' ? 'text-emerald-700 font-bold bg-emerald-50 border border-emerald-200' : 'text-amber-700 bg-amber-50 border border-amber-200' %>">
                      <%= order.paymentStatus %>
                    </span>
                  </td>
                  <td class="py-3 text-right font-bold text-slate-800">
                    R$ <%= Number(order.total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-4 text-center text-slate-400">Sem pedidos registrados até o momento.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
