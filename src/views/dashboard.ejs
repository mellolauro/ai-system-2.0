<div class="space-y-6">

  <!-- Cabeçalho gerencial -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Visão Geral da Operação</h1>
      <p class="text-xs text-slate-500 mt-1">
        Indicadores comerciais e financeiros da empresa.
      </p>
    </div>

    <div class="text-xs text-slate-500">
      Período selecionado:
      <strong class="text-slate-700"><%= period.label %></strong>
    </div>
  </div>

  <!-- Filtros de período -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
    <form
      method="GET"
      action="/dashboard"
      class="flex flex-col gap-4"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider mr-1">
          Período
        </span>

        <% [
          ['today', 'Hoje'],
          ['yesterday', 'Ontem'],
          ['last7days', 'Últimos 7 dias'],
          ['currentMonth', 'Mês atual'],
          ['previousMonth', 'Mês anterior'],
          ['currentYear', 'Ano atual']
        ].forEach(([value, label]) => { %>
          <a
            href="/dashboard?period=<%= value %><%= filters.orderStatus ? '&orderStatus=' + encodeURIComponent(filters.orderStatus) : '' %><%= filters.paymentStatus ? '&paymentStatus=' + encodeURIComponent(filters.paymentStatus) : '' %>"
            data-dashboard-period="<%= value %>"
            data-applied="<%= period.preset === value ? 'true' : 'false' %>"
            class="px-3 py-2 rounded-lg border text-xs font-semibold transition
              <%= period.preset === value
                ? 'bg-indigo-600 border-indigo-600 text-white'
                : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50' %>"
          >
            <%= label %>
          </a>
        <% }) %>

        <button
          type="button"
          id="dashboard-custom-period-toggle"
          data-active="<%= period.preset === 'custom' ? 'true' : 'false' %>"
          class="px-3 py-2 rounded-lg border text-xs font-semibold transition
            <%= period.preset === 'custom'
              ? 'bg-indigo-600 border-indigo-600 text-white'
              : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50' %>"
        >
          Personalizado
        </button>
      </div>

      <div
        id="dashboard-custom-period"
        class="flex-col sm:flex-row sm:items-end gap-3 pt-3 border-t border-slate-100"
        style="display: <%= period.preset === 'custom' ? 'flex' : 'none' %>;"
      >
        <input
          type="hidden"
          name="period"
          value="custom"
        >

        <% if (filters.orderStatus) { %>
          <input
            type="hidden"
            name="orderStatus"
            value="<%= filters.orderStatus %>"
          >
        <% } %>

        <% if (filters.paymentStatus) { %>
          <input
            type="hidden"
            name="paymentStatus"
            value="<%= filters.paymentStatus %>"
          >
        <% } %>

        <div>
          <label
            for="dashboard-start-date"
            class="block text-xs font-semibold text-slate-600 mb-1"
          >
            Data inicial
          </label>

          <input
            id="dashboard-start-date"
            type="date"
            name="start"
            value="<%= period.startInput %>"
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700"
            required
          >
        </div>

        <div>
          <label
            for="dashboard-end-date"
            class="block text-xs font-semibold text-slate-600 mb-1"
          >
            Data final
          </label>

          <input
            id="dashboard-end-date"
            type="date"
            name="end"
            value="<%= period.endInput %>"
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700"
            required
          >
        </div>

        <button
          type="submit"
          class="px-4 py-2 rounded-lg bg-slate-800 text-white text-sm font-semibold hover:bg-slate-900 transition"
        >
          Aplicar
        </button>
      </div>

    </form>
  </div>

  <!-- KPIs gerenciais -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">

    <!-- Faturamento -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
            Faturamento
          </p>

          <h3 class="text-2xl font-bold text-slate-800 mt-1">
            R$ <%= Number(financialSummary.revenue || 0).toLocaleString('pt-BR', {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }) %>
          </h3>
        </div>

        <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
          <i class="fas fa-dollar-sign"></i>
        </div>
      </div>

      <p class="text-[11px] text-slate-500 mt-3">
        <%= financialSummary.orderCount %>
        <%= financialSummary.orderCount === 1 ? 'pedido pago' : 'pedidos pagos' %>
        no período
      </p>

      <p class="text-[11px] mt-1 <%= comparisons.revenue !== null && comparisons.revenue > 0
        ? 'text-emerald-600'
        : comparisons.revenue !== null && comparisons.revenue < 0
          ? 'text-red-600'
          : 'text-slate-400' %>">
        <% if (comparisons.revenue === null) { %>
          Sem base anterior para comparação
        <% } else { %>
          <%= comparisons.revenue > 0 ? '+' : '' %><%= comparisons.revenue.toLocaleString('pt-BR', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }) %>% em relação ao período anterior
        <% } %>
      </p>
    </div>

    <!-- Pedidos -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
            Pedidos
          </p>

          <h3 class="text-2xl font-bold text-slate-800 mt-1">
            <%= ordersCount %>
          </h3>
        </div>

        <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">
          <i class="fas fa-box"></i>
        </div>
      </div>

      <p class="text-[11px] text-slate-500 mt-3">
        Pedidos criados no período
      </p>

      <p class="text-[11px] mt-1 <%= comparisons.orders !== null && comparisons.orders > 0
        ? 'text-emerald-600'
        : comparisons.orders !== null && comparisons.orders < 0
          ? 'text-red-600'
          : 'text-slate-400' %>">
        <% if (comparisons.orders === null) { %>
          Sem base anterior para comparação
        <% } else { %>
          <%= comparisons.orders > 0 ? '+' : '' %><%= comparisons.orders.toLocaleString('pt-BR', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }) %>% em relação ao período anterior
        <% } %>
      </p>
    </div>

    <!-- Ticket médio -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
            Ticket médio
          </p>

          <h3 class="text-2xl font-bold text-slate-800 mt-1">
            R$ <%= Number(averageTicket || 0).toLocaleString('pt-BR', {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }) %>
          </h3>
        </div>

        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
          <i class="fas fa-receipt"></i>
        </div>
      </div>

      <p class="text-[11px] text-slate-500 mt-3">
        Valor médio dos pedidos pagos
      </p>

      <p class="text-[11px] mt-1 <%= comparisons.averageTicket !== null && comparisons.averageTicket > 0
        ? 'text-emerald-600'
        : comparisons.averageTicket !== null && comparisons.averageTicket < 0
          ? 'text-red-600'
          : 'text-slate-400' %>">
        <% if (comparisons.averageTicket === null) { %>
          Sem base anterior para comparação
        <% } else { %>
          <%= comparisons.averageTicket > 0 ? '+' : '' %><%= comparisons.averageTicket.toLocaleString('pt-BR', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }) %>% em relação ao período anterior
        <% } %>
      </p>
    </div>

    <!-- Margem bruta -->
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
            Margem bruta
          </p>

          <% if (financialSummary.hasCompleteCost) { %>
            <h3 class="text-2xl font-bold text-slate-800 mt-1">
              <%= Number(financialSummary.grossMargin || 0).toLocaleString('pt-BR', {
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
              }) %>%
            </h3>
          <% } else { %>
            <h3 class="text-xl font-bold text-slate-500 mt-1">
              Indisponível
            </h3>
          <% } %>
        </div>

        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
          <i class="fas fa-chart-line"></i>
        </div>
      </div>

      <% if (financialSummary.totalUnits === 0) { %>
        <p class="text-[11px] text-slate-500 mt-3">
          Sem vendas pagas no período
        </p>
      <% } else if (!financialSummary.hasCompleteCost) { %>
        <p class="text-[11px] text-amber-700 mt-3">
          <%= Number(financialSummary.costCoverage || 0).toLocaleString('pt-BR', {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }) %>% dos custos informados
        </p>

        <p class="text-[11px] text-slate-400 mt-1">
          Informe os custos restantes para calcular a margem.
        </p>
      <% } else { %>
        <p class="text-[11px] text-slate-500 mt-3">
          Lucro bruto:
          R$ <%= Number(financialSummary.grossProfit || 0).toLocaleString('pt-BR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) %>
        </p>

        <p class="text-[11px] mt-1 <%= comparisons.grossProfit !== null && comparisons.grossProfit > 0
          ? 'text-emerald-600'
          : comparisons.grossProfit !== null && comparisons.grossProfit < 0
            ? 'text-red-600'
            : 'text-slate-400' %>">
          <% if (comparisons.grossProfit === null) { %>
            Sem base anterior para comparação
          <% } else { %>
            <%= comparisons.grossProfit > 0 ? '+' : '' %><%= comparisons.grossProfit.toLocaleString('pt-BR', {
              minimumFractionDigits: 1,
              maximumFractionDigits: 1
            }) %>% de lucro bruto contra o período anterior
          <% } %>
        </p>
      <% } %>
    </div>

  </div>

  <script>
    (() => {
      const toggle =
        document.getElementById(
          "dashboard-custom-period-toggle"
        );

      const customPeriod =
        document.getElementById(
          "dashboard-custom-period"
        );

      if (
        !toggle ||
        !customPeriod
      ) {
        return;
      }

      const periodLinks =
        document.querySelectorAll(
          "[data-dashboard-period]"
        );

      const updateDashboardFilter =
        (
          parameter,
          value
        ) => {

          const url =
            new URL(
              window.location.href
            );

          if (value) {
            url.searchParams.set(
              parameter,
              value
            );
          } else {
            url.searchParams.delete(
              parameter
            );
          }

          window.location.assign(
            url.pathname +
            url.search
          );

        };

      const initializeDashboardFilters =
        () => {

          const orderStatusSelect =
            document.getElementById(
              "dashboard-order-status"
            );

          const paymentStatusSelect =
            document.getElementById(
              "dashboard-payment-status"
            );

          if (orderStatusSelect) {
            orderStatusSelect.addEventListener(
              "change",
              () => {
                updateDashboardFilter(
                  "orderStatus",
                  orderStatusSelect.value
                );
              }
            );
          }

          if (paymentStatusSelect) {
            paymentStatusSelect.addEventListener(
              "change",
              () => {
                updateDashboardFilter(
                  "paymentStatus",
                  paymentStatusSelect.value
                );
              }
            );
          }

        };

      if (document.readyState === "loading") {

        document.addEventListener(
          "DOMContentLoaded",
          initializeDashboardFilters,
          {
            once:
              true
          }
        );

      } else {

        initializeDashboardFilters();

      }

      const setPeriodLinkState =
        (
          link,
          active
        ) => {

          link.classList.toggle(
            "bg-indigo-600",
            active
          );

          link.classList.toggle(
            "border-indigo-600",
            active
          );

          link.classList.toggle(
            "text-white",
            active
          );

          link.classList.toggle(
            "bg-white",
            !active
          );

          link.classList.toggle(
            "border-slate-200",
            !active
          );

          link.classList.toggle(
            "text-slate-600",
            !active
          );

      };

      const restoreAppliedPeriod =
        () => {

          periodLinks.forEach(
            (link) => {
              setPeriodLinkState(
                link,
                link.dataset.applied ===
                  "true"
              );
            }
          );

        };

      const setCustomButtonState =
        (active) => {

          toggle.classList.toggle(
            "bg-indigo-600",
            active
          );

          toggle.classList.toggle(
            "border-indigo-600",
            active
          );

          toggle.classList.toggle(
            "text-white",
            active
          );

          toggle.classList.toggle(
            "bg-white",
            !active
          );

          toggle.classList.toggle(
            "border-slate-200",
            !active
          );

          toggle.classList.toggle(
            "text-slate-600",
            !active
          );

          toggle.classList.toggle(
            "hover:bg-slate-50",
            !active
          );

          toggle.dataset.active =
            active
              ? "true"
              : "false";
        };

      toggle.addEventListener(
        "click",
        () => {

          const opening =
            customPeriod.style.display ===
            "none";

          customPeriod.style.display =
            opening
              ? "flex"
              : "none";

          if (opening) {

            periodLinks.forEach(
              (link) => {
                setPeriodLinkState(
                  link,
                  false
                );
              }
            );

          } else {

            restoreAppliedPeriod();

          }

          setCustomButtonState(
            opening
          );

        }
      );
    })();
  </script>

  <!-- Filtros dos pedidos -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
    <div class="flex flex-col lg:flex-row lg:items-end gap-4">

      <div class="flex-1">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
              Filtros
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

              <div>
                <label
                  for="dashboard-order-status"
                  class="block text-xs font-semibold text-slate-600 mb-1"
                >
                  Status do pedido
                </label>

                <select
                  id="dashboard-order-status"
                  class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white"
                >
                  <option value="">Todos</option>
                  <option value="PENDING" <%= filters.orderStatus === 'PENDING' ? 'selected' : '' %>>
                    Pendente
                  </option>
                  <option value="PROCESSING" <%= filters.orderStatus === 'PROCESSING' ? 'selected' : '' %>>
                    Em processamento
                  </option>
                  <option value="PAID" <%= filters.orderStatus === 'PAID' ? 'selected' : '' %>>
                    Pago
                  </option>
                  <option value="SHIPPED" <%= filters.orderStatus === 'SHIPPED' ? 'selected' : '' %>>
                    Enviado
                  </option>
                  <option value="DELIVERED" <%= filters.orderStatus === 'DELIVERED' ? 'selected' : '' %>>
                    Entregue
                  </option>
                  <option value="CANCELLED" <%= filters.orderStatus === 'CANCELLED' ? 'selected' : '' %>>
                    Cancelado
                  </option>
                  <option value="REFUNDED" <%= filters.orderStatus === 'REFUNDED' ? 'selected' : '' %>>
                    Reembolsado
                  </option>
                </select>
              </div>

              <div>
                <label
                  for="dashboard-payment-status"
                  class="block text-xs font-semibold text-slate-600 mb-1"
                >
                  Status do pagamento
                </label>

                <select
                  id="dashboard-payment-status"
                  class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white"
                >
                  <option value="">Todos</option>
                  <option value="PENDING" <%= filters.paymentStatus === 'PENDING' ? 'selected' : '' %>>
                    Pendente
                  </option>
                  <option value="PAID" <%= filters.paymentStatus === 'PAID' ? 'selected' : '' %>>
                    Pago
                  </option>
                  <option value="FAILED" <%= filters.paymentStatus === 'FAILED' ? 'selected' : '' %>>
                    Falhou
                  </option>
                  <option value="REFUNDED" <%= filters.paymentStatus === 'REFUNDED' ? 'selected' : '' %>>
                    Reembolsado
                  </option>
                  <option value="CANCELLED" <%= filters.paymentStatus === 'CANCELLED' ? 'selected' : '' %>>
                    Cancelado
                  </option>
                </select>
              </div>

            </div>
      </div>

          <% if (filters.orderStatus || filters.paymentStatus) { %>
            <a
              href="/dashboard?period=<%= period.preset %><%= period.preset === 'custom' ? '&start=' + encodeURIComponent(period.startInput) + '&end=' + encodeURIComponent(period.endInput) : '' %>"
              class="inline-flex items-center justify-center px-3 py-2 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition"
            >
              Limpar filtros
            </a>
          <% } %>

    </div>
  </div>

  <!-- Últimos Pedidos -->
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-base font-bold text-slate-800">
          Últimos Pedidos
        </h3>
        <p class="text-[11px] text-slate-500 mt-1">
          Pedidos mais recentes da operação.
        </p>
      </div>

      <a
        href="/orders"
        class="text-xs font-semibold text-blue-600 hover:underline"
      >
        Ver todos
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-100 text-slate-400 uppercase tracking-wider font-semibold">
            <th class="py-2.5">ID / Data</th>
            <th class="py-2.5">Cliente</th>
            <th class="py-2.5">Status</th>
            <th class="py-2.5">Pagamento</th>
            <th class="py-2.5 text-right">Total</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          <% if (
            typeof recentOrders !== 'undefined' &&
            recentOrders.length > 0
          ) { %>

            <% recentOrders.forEach(order => { %>
              <tr class="hover:bg-slate-50/70 transition">
                <td class="py-3">
                  <span class="font-mono font-bold text-blue-600">
                    #<%= order.id.slice(-6).toUpperCase() %>
                  </span>

                  <span class="block text-[10px] text-slate-400">
                    <%= new Date(order.createdAt).toLocaleDateString('pt-BR') %>
                  </span>
                </td>

                <td class="py-3 font-medium text-slate-700">
                  <%= order.user ? order.user.name : 'N/A' %>
                </td>

                <td class="py-3">
                  <span
                    class="px-2 py-0.5 rounded font-semibold text-[10px]
                      <%= order.status === 'SHIPPED'
                        ? 'bg-purple-50 text-purple-700'
                        : order.status === 'DELIVERED'
                          ? 'bg-emerald-50 text-emerald-700'
                          : 'bg-slate-100 text-slate-600' %>"
                  >
                    <%= orderStatusLabel(order.status) %>
                  </span>
                </td>

                <td class="py-3">
                  <span
                    class="px-1.5 py-0.5 rounded text-[10px]
                      <%= order.paymentStatus === 'PAID'
                        ? 'text-emerald-700 font-bold bg-emerald-50 border border-emerald-200'
                        : 'text-amber-700 bg-amber-50 border border-amber-200' %>"
                  >
                    <%= paymentStatusLabel(order.paymentStatus) %>
                  </span>
                </td>

                <td class="py-3 text-right font-bold text-slate-800">
                  R$ <%= Number(order.total).toLocaleString(
                    'pt-BR',
                    {
                      minimumFractionDigits: 2
                    }
                  ) %>
                </td>
              </tr>
            <% }) %>

          <% } else { %>
            <tr>
              <td
                colspan="5"
                class="py-6 text-center text-slate-400"
              >
                Sem pedidos registrados até o momento.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Saúde do Sistema -->
  <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
    <div class="mb-4">
      <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
        <i class="fas fa-heartbeat text-emerald-600"></i>
        Saúde do Sistema
      </h3>

      <p class="text-[11px] text-slate-500 mt-1">
        Estado dos principais serviços da operação.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">

      <% [
        {
          label: 'Aplicação',
          description: 'Painel administrativo e serviços web',
          status: systemHealth.application.status
        },
        {
          label: 'Banco de dados',
          description: 'Persistência e acesso aos dados',
          status: systemHealth.database.status
        },
        {
          label: 'Inteligência Artificial',
          description: 'Serviços de IA e atendimento',
          status: systemHealth.artificialIntelligence.status
        }
      ].forEach(service => { %>

        <% const operational =
          service.status === 'operational'; %>

        <div class="flex items-center justify-between gap-4 p-4 bg-slate-50 rounded-lg border border-slate-100">
          <div class="min-w-0">
            <p class="text-xs font-semibold text-slate-700">
              <%= service.label %>
            </p>

            <p class="text-[10px] text-slate-400 mt-1">
              <%= service.description %>
            </p>
          </div>

          <span
            class="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold
              <%= operational
                ? 'bg-emerald-100 text-emerald-700'
                : 'bg-red-100 text-red-700' %>"
          >
            <span
              class="w-1.5 h-1.5 rounded-full
                <%= operational
                  ? 'bg-emerald-500'
                  : 'bg-red-500' %>"
            ></span>

            <%= operational
              ? 'Operacional'
              : 'Indisponível' %>
          </span>
        </div>

      <% }) %>

    </div>
  </div>


  <!-- Assistente Administrativo -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">

    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
          <i class="fas fa-wand-magic-sparkles text-indigo-600"></i>
          Assistente Administrativo
        </h3>

        <p class="text-xs text-slate-500 mt-1">
          Consulte faturamento, pedidos, custos e indicadores da operação.
        </p>
      </div>

      <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 px-2 py-1 rounded-full">
        ADMIN
      </span>
    </div>

    <div
      id="admin-assistant-messages"
      class="p-6 min-h-[180px] max-h-[420px] overflow-y-auto space-y-4 bg-slate-50/50"
    >
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 shrink-0 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center">
          <i class="fas fa-robot text-sm"></i>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl rounded-tl-sm px-4 py-3 text-sm text-slate-700 shadow-sm max-w-3xl">
          Faça uma pergunta sobre a operação. Para consultas financeiras, informe o período desejado.
        </div>
      </div>
    </div>

    <form
      id="admin-assistant-form"
      class="p-4 border-t border-slate-100 bg-white"
    >
      <div class="flex items-end gap-3">

        <textarea
          id="admin-assistant-input"
          rows="2"
          maxlength="2000"
          placeholder="Ex.: Qual foi meu faturamento e margem bruta hoje?"
          class="flex-1 resize-none rounded-xl border border-slate-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          required
        ></textarea>

        <button
          id="admin-assistant-microphone"
          type="button"
          title="Usar reconhecimento de voz"
          aria-label="Usar reconhecimento de voz"
          class="h-[46px] w-[46px] shrink-0 rounded-xl border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 hover:text-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed transition flex items-center justify-center"
        >
          <i class="fas fa-microphone"></i>
        </button>

        <button
          id="admin-assistant-submit"
          type="submit"
          class="h-[46px] px-5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed transition"
        >
          <i class="fas fa-paper-plane mr-2"></i>
          Enviar
        </button>

      </div>

      <p
        id="admin-assistant-status"
        class="hidden mt-2 text-xs text-slate-500"
      ></p>
    </form>

  </div>

<script>
(() => {
  const form =
    document.getElementById(
      "admin-assistant-form"
    );

  const input =
    document.getElementById(
      "admin-assistant-input"
    );

  const messages =
    document.getElementById(
      "admin-assistant-messages"
    );

  const submit =
    document.getElementById(
      "admin-assistant-submit"
    );

  const microphone =
    document.getElementById(
      "admin-assistant-microphone"
    );

  const status =
    document.getElementById(
      "admin-assistant-status"
    );

  if (
    !form ||
    !input ||
    !messages ||
    !submit ||
    !microphone ||
    !status
  ) {
    return;
  }

  const csrfInput =
    document.querySelector(
      'input[name="_csrf"]'
    );


    /*
     * Síntese de voz das respostas do assistente.
     * A reprodução é iniciada somente pelo usuário.
     */
    const speechSynthesisSupported =
      "speechSynthesis" in window &&
      "SpeechSynthesisUtterance" in window;

    let speakingButton = null;
    let currentUtterance = null;

    function resetSpeakingButton() {
      if (speakingButton) {
        const icon =
          speakingButton.querySelector("i");

        if (icon) {
          icon.className =
            "fas fa-volume-up";
        }

        speakingButton.classList.remove(
          "text-indigo-600",
          "bg-indigo-50",
          "ring-2",
          "ring-indigo-200",
          "animate-pulse"
        );

        speakingButton.title =
          "Ouvir resposta";

        speakingButton.setAttribute(
          "aria-label",
          "Ouvir resposta"
        );
      }

      speakingButton = null;
      currentUtterance = null;
    }

    function stopSpeaking() {
      if (!speechSynthesisSupported) {
        return;
      }

      window.speechSynthesis.cancel();
      resetSpeakingButton();
    }

    function speakAnswer(
      content,
      button,
      onFinished = null
    ) {
      if (!speechSynthesisSupported) {
        return;
      }

      if (
        speakingButton === button &&
        (
          window.speechSynthesis.speaking ||
          window.speechSynthesis.pending
        )
      ) {
        stopSpeaking();
        return;
      }

      stopSpeaking();

      const utterance =
        new SpeechSynthesisUtterance(
          content
        );

      utterance.lang = "pt-BR";
      utterance.rate = 1;
      utterance.pitch = 1;

      currentUtterance = utterance;
      speakingButton = button;

      const icon =
        button.querySelector("i");

      if (icon) {
        icon.className =
          "fas fa-stop";
      }

      button.classList.add(
        "text-indigo-600",
        "bg-indigo-50",
        "ring-2",
        "ring-indigo-200",
        "animate-pulse"
      );

      button.title =
        "Parar leitura";

      button.setAttribute(
        "aria-label",
        "Parar leitura"
      );

        utterance.onend =
          () => {
            if (
              currentUtterance !==
              utterance
            ) {
              return;
            }

            resetSpeakingButton();

            if (
              typeof onFinished ===
              "function"
            ) {
              onFinished();
            }
          };

      utterance.onerror =
        () => {
          if (
            currentUtterance ===
            utterance
          ) {
            resetSpeakingButton();
          }
        };

      window.speechSynthesis.speak(
        utterance
      );
    }

  function addMessage(
    content,
    type
  ) {
    const wrapper =
      document.createElement("div");

    wrapper.className =
      type === "user"
        ? "flex items-start justify-end gap-3"
        : "flex items-start gap-3";

    const bubble =
      document.createElement("div");

    bubble.className =
      type === "user"
        ? "bg-indigo-600 text-white rounded-xl rounded-tr-sm px-4 py-3 text-sm shadow-sm max-w-3xl whitespace-pre-wrap"
        : "bg-white border border-slate-200 rounded-xl rounded-tl-sm px-4 py-3 text-sm text-slate-700 shadow-sm max-w-3xl whitespace-pre-wrap";

    /*
     * textContent evita interpretar HTML vindo
     * da resposta do agente.
     */
    bubble.textContent =
      content;

    wrapper.appendChild(bubble);

      let speechButton = null;


      /*
       * Botão de áudio disponível somente
       * nas respostas do assistente.
       */
      if (
        type === "assistant" &&
        speechSynthesisSupported
      ) {
        speechButton =
          document.createElement(
            "button"
          );

        speechButton.type =
          "button";

        speechButton.className =
          "h-9 w-9 shrink-0 mt-1 rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 hover:text-indigo-600 transition flex items-center justify-center";

        speechButton.title =
          "Ouvir resposta";

        speechButton.setAttribute(
          "aria-label",
          "Ouvir resposta"
        );

        const speechIcon =
          document.createElement("i");

        speechIcon.className =
          "fas fa-volume-up";

        speechButton.appendChild(
          speechIcon
        );

        speechButton.addEventListener(
          "click",
          () => {
            speakAnswer(
              content,
              speechButton
            );
          }
        );

        wrapper.appendChild(
          speechButton
        );
      }
    messages.appendChild(wrapper);

    messages.scrollTop =
      messages.scrollHeight;

      return speechButton;
  }

  /*
   * Reconhecimento de voz.
   * Apenas transcreve; não envia automaticamente.
   */
  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  let recognition = null;
  let isListening = false;
  let voiceBaseText = "";


    /*
     * Modo conversa por voz.
     *
     * O envio automático será disparado somente
     * depois de um período de silêncio.
     */
    let conversationMode = false;
      let waitingForAssistant = false;
      let assistantIsSpeaking = false;
    let silenceTimer = null;

    const VOICE_SILENCE_DELAY =
      2000;

    function clearSilenceTimer() {
      if (!silenceTimer) {
        return;
      }

      clearTimeout(
        silenceTimer
      );

      silenceTimer = null;
    }

    function setConversationMode(
      enabled
    ) {
      conversationMode = enabled;

      if (!enabled) {
        clearSilenceTimer();
      }
    }

  function setListeningState(listening) {
    isListening = listening;

    microphone.classList.toggle(
      "bg-red-50",
      listening
    );

    microphone.classList.toggle(
      "border-red-400",
      listening
    );

    microphone.classList.toggle(
      "text-red-600",
      listening
    );

    microphone.classList.toggle(
      "ring-2",
      listening
    );

    microphone.classList.toggle(
      "ring-red-200",
      listening
    );

    microphone.classList.toggle(
      "animate-pulse",
      listening
    );

    const icon =
      microphone.querySelector("i");

    if (icon) {
      icon.className =
        listening
          ? "fas fa-stop"
          : "fas fa-microphone";
    }

    microphone.title =
      listening
        ? "Parar reconhecimento de voz"
        : "Usar reconhecimento de voz";

    microphone.setAttribute(
      "aria-label",
      microphone.title
    );
  }

  if (!SpeechRecognition) {
    microphone.disabled = true;

    microphone.title =
      "Reconhecimento de voz não suportado neste navegador";

    microphone.setAttribute(
      "aria-label",
      microphone.title
    );

  } else {
    recognition =
      new SpeechRecognition();

    recognition.lang = "pt-BR";
    recognition.continuous = true;
    recognition.interimResults = true;

    recognition.onstart =
      () => {
        setListeningState(true);

        status.textContent =
          "Ouvindo... clique novamente no microfone para parar.";

        status.classList.remove(
          "hidden"
        );
      };

    recognition.onresult =
      event => {
        let finalText = "";
        let interimText = "";

        for (
          let i = event.resultIndex;
          i < event.results.length;
          i++
        ) {
          const transcript =
            event.results[i][0].transcript;

          if (event.results[i].isFinal) {
            finalText += transcript;
          } else {
            interimText += transcript;
          }
        }

        if (finalText.trim()) {
          voiceBaseText =
            [
              voiceBaseText,
              finalText.trim()
            ]
              .filter(Boolean)
              .join(" ");
        }


          /*
           * Qualquer nova atividade de voz cancela
           * a contagem de silêncio anterior.
           */
          clearSilenceTimer();

          /*
           * Somente uma transcrição final inicia
           * a contagem para possível envio.
           */
          if (
            conversationMode &&
            finalText.trim()
          ) {
            status.textContent =
              "Pergunta detectada. Aguardando 2 segundos de silêncio...";

            status.classList.remove(
              "hidden"
            );

            silenceTimer =
              setTimeout(
                () => {
                  silenceTimer = null;

                  if (
                    !conversationMode ||
                    !input.value.trim() ||
                    input.disabled
                  ) {
                    return;
                  }

                  status.textContent =
                    "Enviando pergunta...";

                  status.classList.remove(
                    "hidden"
                  );

                  /*
                   * Interrompe a escuta antes de enviar.
                   * Isso será importante quando a resposta
                   * passar a ser lida em voz alta.
                   */
                  if (isListening) {
                    recognition.stop();
                  }

                    waitingForAssistant = true;

                  form.requestSubmit();
                },
                VOICE_SILENCE_DELAY
              );
          }

        input.value =
          [
            voiceBaseText,
            interimText.trim()
          ]
            .filter(Boolean)
            .join(" ");
      };

      recognition.onerror =
        event => {
          setListeningState(false);

          if (
            event.error === "not-allowed" ||
            event.error === "service-not-allowed"
          ) {
            setConversationMode(false);

            status.textContent =
              "Permissão do microfone negada pelo navegador.";

          } else if (
            event.error === "no-speech"
          ) {
            /*
             * No modo conversa, ausência de fala
             * não encerra a sessão. O onend fará
             * uma nova tentativa de escuta.
             */
            if (conversationMode) {
              status.textContent =
                "Modo conversa ativo. Aguardando sua fala...";
            } else {
              status.textContent =
                "Nenhuma fala foi detectada.";
            }

          } else {
            /*
             * Erros inesperados encerram o modo
             * para evitar ciclos de reinício.
             */
            setConversationMode(false);

            status.textContent =
              "Não foi possível usar o reconhecimento de voz.";
          }

          status.classList.remove(
            "hidden"
          );
        };

      recognition.onend =
        () => {
          setListeningState(false);

          /*
           * Enquanto aguardamos a IA ou enquanto
           * ela está falando, o microfone deve
           * permanecer desligado.
           */
          if (
            !conversationMode ||
            waitingForAssistant ||
            assistantIsSpeaking
          ) {
            return;
          }

          status.textContent =
            "Modo conversa ativo. Aguardando sua fala...";

          status.classList.remove(
            "hidden"
          );

          /*
           * O Web Speech API pode encerrar uma
           * sessão mesmo sem o usuário desligar
           * o modo conversa. Reiniciamos após
           * um pequeno intervalo.
           */
          setTimeout(
            () => {
              if (
                !conversationMode ||
                waitingForAssistant ||
                assistantIsSpeaking ||
                isListening
              ) {
                return;
              }

              try {
                recognition.start();
              } catch (err) {
                setConversationMode(false);

                status.textContent =
                  "Não foi possível continuar o modo conversa por voz.";

                status.classList.remove(
                  "hidden"
                );
              }
            },
            250
          );
        };

      microphone.addEventListener(
        "click",
        () => {
          /*
           * Se o modo conversa já estiver ativo,
           * o clique encerra a conversa.
           */
          if (conversationMode) {
            setConversationMode(false);

            clearSilenceTimer();

            if (isListening) {
              recognition.stop();
            }

            status.textContent =
              "Modo conversa por voz encerrado.";

            status.classList.remove(
              "hidden"
            );

            return;
          }

          /*
           * Inicia o modo conversa.
           */
          setConversationMode(true);

          voiceBaseText =
            input.value.trim();

          status.textContent =
            "Modo conversa ativo. Pode falar.";

          status.classList.remove(
            "hidden"
          );

          try {
            recognition.start();
          } catch (err) {
            setConversationMode(false);

            status.textContent =
              "Não foi possível iniciar o modo conversa por voz.";

            status.classList.remove(
              "hidden"
            );
        }
      }
    );
  }

  /*
   * Enter envia a mensagem.
   * Shift+Enter insere uma nova linha.
   */
  input.addEventListener(
    "keydown",
    event => {
      if (
        event.key === "Enter" &&
        !event.shiftKey &&
        !input.disabled
      ) {
        event.preventDefault();

        if (input.value.trim()) {
          form.requestSubmit();
        }
      }
    }
  );

  form.addEventListener(
    "submit",
    async event => {
      event.preventDefault();

      const message =
        input.value.trim();

      if (!message) {
        return;
      }

      if (
        !csrfInput ||
        !csrfInput.value
      ) {
        status.textContent =
          "Token de segurança indisponível. Atualize a página.";

        status.classList.remove(
          "hidden"
        );

        return;
      }

      addMessage(
        message,
        "user"
      );

      input.value = "";
      input.disabled = true;
      submit.disabled = true;

      status.textContent =
        "Consultando o assistente...";

      status.classList.remove(
        "hidden"
      );

      try {
        const response =
          await fetch(
            "/api/admin/chat",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",

                "x-csrf-token":
                  csrfInput.value
              },

              body:
                JSON.stringify({
                  message
                })
            }
          );

        const payload =
          await response.json();

        if (
          !response.ok ||
          !payload.success
        ) {
          throw new Error(
            payload.message ||
            payload.error ||
            "Não foi possível processar a solicitação."
          );
        }

          waitingForAssistant = false;

        const answer =
          payload.data &&
          typeof payload.data.response === "string"
            ? payload.data.response
            : "O assistente não retornou uma resposta textual.";

          const answerSpeechButton =
            addMessage(
              answer,
              "assistant"
            );

          /*
           * No modo conversa, lê a resposta
           * automaticamente e só depois
           * volta a ouvir o usuário.
           */
          if (
            conversationMode &&
            answerSpeechButton &&
            speechSynthesisSupported
          ) {
            status.textContent =
              "Assistente respondendo por voz...";

            status.classList.remove(
              "hidden"
            );

            assistantIsSpeaking = true;

            speakAnswer(
              answer,
              answerSpeechButton,
              () => {
                /*
                 * O usuário pode ter encerrado
                 * o modo conversa durante a leitura.
                 */
                assistantIsSpeaking = false;

                if (!conversationMode) {
                  return;
                }

                /*
                 * A pergunta anterior não pode
                 * entrar na próxima transcrição.
                 */
                input.value = "";
                voiceBaseText = "";

                status.textContent =
                  "Modo conversa ativo. Pode falar.";

                status.classList.remove(
                  "hidden"
                );

                try {
                  recognition.start();
                } catch (err) {
                  setConversationMode(false);

                  status.textContent =
                    "Não foi possível continuar o modo conversa por voz.";

                  status.classList.remove(
                    "hidden"
                  );
                }
              }
            );
          } else {
            status.classList.add(
              "hidden"
            );
          }

      } catch (err) {
          waitingForAssistant = false;
          assistantIsSpeaking = false;
          setConversationMode(false);


        addMessage(
          "Não foi possível consultar o assistente neste momento.",
          "assistant"
        );

        status.textContent =
          err.message ||
          "Erro ao consultar o assistente.";

        status.classList.remove(
          "hidden"
        );

      } finally {
        input.disabled = false;
        submit.disabled = false;
        input.focus();
      }
    }
  );
})();
</script>

</div>
