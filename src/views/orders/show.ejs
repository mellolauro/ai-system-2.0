<!-- CARD DE ASSOCIAÇÃO DO ENTREGADOR -->
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-4">
  <h3 class="text-md font-bold text-slate-800 flex items-center gap-2">
    <i class="fas fa-shipping-fast text-blue-600"></i> Entregador Responsável
  </h3>

  <form action="/dashboard/orders/<%= order.id %>/assign-driver" method="POST" class="flex gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="driverId" class="flex-1 bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none">
      <option value="">-- Selecione um entregador --</option>
      <% drivers.forEach(driver => { %>
        <option value="<%= driver.id %>" <%= order.driverId === driver.id ? 'selected' : '' %>>
          🛵 <%= driver.name %> (<%= driver.phone %>)
        </option>
      <% }) %>
    </select>

    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2.5 rounded-lg text-sm transition-all shadow-sm">
      Vincular
    </button>
  </form>

  <% if (order.driver) { %>
    <div class="p-3 bg-blue-50 border border-blue-100 rounded-lg flex items-center justify-between text-sm">
      <div>
        <p class="font-bold text-blue-900"><%= order.driver.name %></p>
        <p class="text-xs text-blue-700">📱 <%= order.driver.phone %> | 🛵 <%= order.driver.vehicle || 'Sem veículo' %></p>
      </div>
      <a href="/dashboard/tracking" class="text-xs font-semibold text-blue-600 hover:underline flex items-center gap-1">
        <i class="fas fa-map-marker-alt"></i> Ver no Mapa
      </a>
    </div>
  <% } %>
</div>
