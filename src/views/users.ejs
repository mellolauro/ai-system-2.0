<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-800">Gerenciar Usuários & Contatos</h1>
    <p class="text-xs text-slate-500 mt-1">Clientes identificados por WhatsApp, Telegram e permissões do sistema.</p>
  </div>
  <a href="/users/new" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition shadow-sm flex items-center gap-2 text-sm">
    <i class="fas fa-user-plus"></i> Novo Usuário
  </a>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden border border-slate-200">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-sm">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Cliente</th>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Função (Role)</th>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Canais Conectados</th>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Tenant (Empresa)</th>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">IA / Memória</th>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">Pedidos</th>
          <th class="p-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (typeof users !== 'undefined' && users.length > 0) { %>
          <% users.forEach(user => { %>
            <tr class="hover:bg-slate-50/70 transition-colors">
              
              <!-- Nome / E-mail -->
              <td class="p-4">
                <div class="font-bold text-slate-800"><%= user.name %></div>
                <div class="text-xs text-slate-400">
                  <%= user.email ? user.email : 'Sem e-mail' %>
                </div>
              </td>

              <!-- Role (USER / ADMIN) -->
              <td class="p-4">
                <% if (user.role === 'ADMIN') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    <i class="fas fa-shield-halved text-[10px]"></i> ADMIN
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                    CLIENTE
                  </span>
                <% } %>
              </td>

              <!-- Canais -->
              <td class="p-4">
                <div class="flex flex-wrap items-center gap-2">
                  <% if (user.phone) { %>
                    <a href="https://wa.me/<%= user.phone.replace(/\D/g, '') %>" target="_blank" class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition">
                      <i class="fab fa-whatsapp"></i> <%= user.phone %>
                    </a>
                  <% } %>

                  <% if (user.telegramId) { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200">
                      <i class="fab fa-telegram"></i> <span class="font-mono"><%= user.telegramId %></span>
                    </span>
                  <% } %>

                  <% if (!user.phone && !user.telegramId) { %>
                    <span class="text-xs text-slate-400 italic">Nenhum canal</span>
                  <% } %>
                </div>
              </td>

              <!-- Tenant -->
              <td class="p-4">
                <span class="inline-block px-2.5 py-0.5 bg-slate-100 text-slate-700 rounded text-xs font-medium border border-slate-200">
                  <%= user.tenant ? user.tenant.name : 'Geral' %>
                </span>
              </td>

              <!-- Memória IA -->
              <td class="p-4 text-center">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-semibold">
                  <i class="fas fa-brain text-[10px]"></i>
                  <%= (user._count && user._count.memories) ? user._count.memories : 0 %>
                </span>
              </td>

              <!-- Total Pedidos -->
              <td class="p-4 text-center font-semibold text-slate-700">
                <%= (user._count && user._count.orders) ? user._count.orders : 0 %>
              </td>

              <!-- Ações -->
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-3 text-slate-400">
                  <a href="/users/edit/<%= user.id %>" class="hover:text-blue-600 transition" title="Editar Usuário">
                    <i class="fas fa-user-edit"></i>
                  </a>
                  <a href="/users/delete/<%= user.id %>" onclick="return confirm('Excluir este usuário?')" class="hover:text-rose-600 transition" title="Excluir Usuário">
                    <i class="fas fa-trash"></i>
                  </a>
                </div>
              </td>

            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="p-8 text-center text-slate-400">Nenhum usuário cadastrado.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
