<div class="p-6 max-w-7xl mx-auto space-y-6">

  <!-- CABEÇALHO DA PÁGINA -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">

    <div>

      <a
        href="/orders"
        class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 font-medium mb-1"
      >
        <i class="fas fa-arrow-left"></i>
        Voltar aos Pedidos
      </a>

      <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
        Pedido #<%= order.id ? order.id.slice(-8).toUpperCase() : '' %>
      </h1>

      <p class="text-xs text-slate-500">
        Criado em <%= new Date(order.createdAt).toLocaleString('pt-BR') %>
      </p>

    </div>

    <div class="flex items-center gap-3">

      <a
        href="/orders/print/<%= order.id %>"
        target="_blank"
        class="inline-flex items-center gap-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-medium px-4 py-2 rounded-lg text-sm transition-all shadow-sm"
      >
        <i class="fas fa-print text-slate-500"></i>
        Imprimir Recibo
      </a>

    </div>

  </div>


  <!-- CONTEÚDO PRINCIPAL -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">


    <!-- ========================================== -->
    <!-- COLUNA ESQUERDA -->
    <!-- ========================================== -->

    <div class="lg:col-span-2 space-y-6">

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

        <div class="p-5 border-b border-slate-100 flex items-center justify-between">

          <h2 class="text-md font-bold text-slate-800">
            Itens do Pedido
          </h2>

          <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-2.5 py-1 rounded-full">
            <%= order.items ? order.items.length : 0 %>
            <%= (order.items && order.items.length === 1) ? 'item' : 'itens' %>
          </span>

        </div>


        <!-- ITENS -->
        <div class="divide-y divide-slate-100">

          <% if (order.items && order.items.length > 0) { %>

            <% order.items.forEach(item => { %>

              <div class="p-4 flex items-center justify-between gap-4">

                <div class="flex items-center gap-3">

                  <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 font-bold text-xs">
                    <i class="fas fa-box text-base"></i>
                  </div>

                  <div>

                    <p class="text-sm font-semibold text-slate-800">
                      <%= item.product
                        ? item.product.name
                        : (item.productName || 'Produto Indisponível')
                      %>
                    </p>

                    <p class="text-xs text-slate-500">
                      Qtd: <%= item.quantity %>
                      x
                      R$ <%= Number(item.price || 0).toLocaleString(
                        'pt-BR',
                        {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2
                        }
                      ) %>
                    </p>

                  </div>

                </div>


                <div class="text-right">

                  <p class="text-sm font-bold text-slate-800">

                    R$ <%= Number(
                      (item.price || 0) *
                      (item.quantity || 1)
                    ).toLocaleString(
                      'pt-BR',
                      {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                      }
                    ) %>

                  </p>

                </div>

              </div>

            <% }) %>

          <% } else { %>

            <div class="p-8 text-center text-slate-400 text-sm">
              Nenhum item registrado.
            </div>

          <% } %>

        </div>


        <!-- CÁLCULO DOS VALORES -->
        <%

          let subtotal = 0;

          if (
            order.items &&
            order.items.length > 0
          ) {

            subtotal =
              order.items.reduce(
                (acc, curr) => {

                  return (
                    acc +
                    (
                      Number(curr.price || 0) *
                      (curr.quantity || 1)
                    )
                  );

                },
                0
              );

          } else {

            subtotal =
              Number(order.total || 0);

          }

          let freight =
            Number(order.freight || 0);

          let total =
            Number(
              order.total ||
              (subtotal + freight)
            );

        %>


        <div class="bg-slate-50 p-5 border-t border-slate-100 space-y-2 text-sm">

          <div class="flex justify-between text-slate-600">

            <span>
              Subtotal
            </span>

            <span class="font-medium text-slate-800">

              R$ <%= subtotal.toLocaleString(
                'pt-BR',
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>

            </span>

          </div>


          <div class="flex justify-between text-slate-600">

            <span>
              Frete
            </span>

            <span
              class="font-medium <%= freight === 0
                ? 'text-green-600'
                : 'text-slate-800'
              %>"
            >

              <%= freight === 0
                ? 'Grátis'
                : 'R$ ' + freight.toLocaleString(
                    'pt-BR',
                    {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }
                  )
              %>

            </span>

          </div>


          <div class="flex justify-between text-base font-bold text-slate-900 pt-2 border-t border-slate-200">

            <span>
              Total do Pedido
            </span>

            <span class="text-blue-600">

              R$ <%= total.toLocaleString(
                'pt-BR',
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>

            </span>

          </div>

        </div>

      </div>

    </div>


    <!-- ========================================== -->
    <!-- COLUNA DIREITA -->
    <!-- ========================================== -->

    <div class="space-y-6">


      <!-- DADOS DO CLIENTE -->
      <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-3">

        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
          Dados do Cliente
        </h3>


        <% if (order.user) { %>

          <div>

            <p class="font-bold text-slate-800 text-sm">
              <%= order.user.name || 'Cliente sem nome' %>
            </p>

            <p class="text-xs text-slate-500">
              <%= order.user.email || 'Sem e-mail' %>
            </p>


            <% if (order.user.phone) { %>

              <p class="text-xs text-slate-500 mt-1">
                📱 <%= order.user.phone %>
              </p>

            <% } %>


            <% if (order.user.telegramId) { %>

              <p class="text-xs text-blue-600 mt-1">
                ✈️ Telegram ID:
                <%= order.user.telegramId %>
              </p>

            <% } %>

          </div>

        <% } else { %>

          <p class="text-xs text-slate-400">
            Cliente não associado
          </p>

        <% } %>

      </div>


      <!-- ========================================== -->
      <!-- LOGÍSTICA & ENVIO -->
      <!-- ========================================== -->

      <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-4">

        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
          Logística & Envio
        </h3>


        <%

          /*
           * Resolve a Delivery atualmente associada
           * ao pedido.
           */
          let activeDelivery =
            null;

          if (
            typeof currentDelivery !==
                'undefined' &&
            currentDelivery
          ) {

            activeDelivery =
              currentDelivery;

          } else if (
            order.delivery
          ) {

            activeDelivery =
              order.delivery;

          } else if (
            order.deliveries &&
            order.deliveries.length > 0
          ) {

            activeDelivery =
              order.deliveries[
                order.deliveries.length - 1
              ];

          }

          let activeDriverId =
            activeDelivery
              ? activeDelivery.driverId
              : null;

        %>


        <!-- ====================================== -->
        <!-- ENDEREÇO DE ENTREGA -->
        <!-- ====================================== -->

        <% if (
          activeDelivery &&
          (
            activeDelivery.addressLine ||
            activeDelivery.city ||
            activeDelivery.state ||
            activeDelivery.zipCode
          )
        ) { %>

          <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg">

            <p class="text-xs uppercase font-semibold text-slate-400 mb-1">
              Endereço de Entrega
            </p>

            <% if (activeDelivery.addressLine) { %>

              <p class="text-sm font-medium text-slate-700">
                <%= activeDelivery.addressLine %>
              </p>

            <% } %>


            <p class="text-xs text-slate-500 mt-1">

              <% if (activeDelivery.city) { %>
                <%= activeDelivery.city %>
              <% } %>

              <% if (
                activeDelivery.city &&
                activeDelivery.state
              ) { %>
                /
              <% } %>

              <% if (activeDelivery.state) { %>
                <%= activeDelivery.state %>
              <% } %>

              <% if (activeDelivery.zipCode) { %>
                - CEP <%= activeDelivery.zipCode %>
              <% } %>

            </p>


            <% if (activeDelivery.reference) { %>

              <p class="text-xs text-slate-500 mt-1">
                Referência:
                <%= activeDelivery.reference %>
              </p>

            <% } %>

          </div>

        <% } %>


        <!-- ====================================== -->
        <!-- FORMULÁRIO -->
        <!-- ====================================== -->

        <form
          action="/orders/update-status/<%= order.id %>"
          method="POST"
          class="space-y-4"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- STATUS DO PEDIDO -->
          <div>

            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">
              Status do Pedido
            </label>

            <select
              name="status"
              class="w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none"
            >

              <option
                value="PENDING"
                <%= order.status === 'PENDING'
                  ? 'selected'
                  : ''
                %>
              >
                PENDING (Pendente)
              </option>


              <option
                value="PROCESSING"
                <%= order.status === 'PROCESSING'
                  ? 'selected'
                  : ''
                %>
              >
                PROCESSING (Em Processamento)
              </option>


              <option
                value="SHIPPED"
                <%= (
                  order.status === 'SHIPPED' ||
                  order.status === 'SENT'
                )
                  ? 'selected'
                  : ''
                %>
              >
                SHIPPED (Enviado)
              </option>


              <option
                value="DELIVERED"
                <%= order.status === 'DELIVERED'
                  ? 'selected'
                  : ''
                %>
              >
                DELIVERED (Entregue)
              </option>


              <option
                value="CANCELLED"
                <%= (
                  order.status === 'CANCELLED' ||
                  order.status === 'CANCELED'
                )
                  ? 'selected'
                  : ''
                %>
              >
                CANCELLED (Cancelado)
              </option>

            </select>

          </div>


          <!-- STATUS DO PAGAMENTO -->
          <div>

            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">
              Status do Pagamento
            </label>

            <select
              name="paymentStatus"
              class="w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none"
            >

              <option
                value="PENDING"
                <%= order.paymentStatus === 'PENDING'
                  ? 'selected'
                  : ''
                %>
              >
                PENDING (Pendente)
              </option>


              <option
                value="PAID"
                <%= order.paymentStatus === 'PAID'
                  ? 'selected'
                  : ''
                %>
              >
                PAID (Pago)
              </option>


              <option
                value="REFUNDED"
                <%= order.paymentStatus === 'REFUNDED'
                  ? 'selected'
                  : ''
                %>
              >
                REFUNDED (Reembolsado)
              </option>


              <option
                value="FAILED"
                <%= order.paymentStatus === 'FAILED'
                  ? 'selected'
                  : ''
                %>
              >
                FAILED (Falhou)
              </option>

            </select>

          </div>


          <!-- ENTREGADOR -->
          <div>

            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">
              Entregador Responsável
            </label>

            <select
              name="driverId"
              class="w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none"
            >

              <option value="">
                -- Nenhum / Sem Entregador --
              </option>


              <% if (
                typeof drivers !== 'undefined' &&
                drivers &&
                drivers.length > 0
              ) { %>

                <% drivers.forEach(driver => { %>

                  <option
                    value="<%= driver.id %>"
                    <%= activeDriverId === driver.id
                      ? 'selected'
                      : ''
                    %>
                  >
                    🛵 <%= driver.name %>
                    <%= driver.phone
                      ? '(' + driver.phone + ')'
                      : ''
                    %>
                  </option>

                <% }) %>

              <% } %>

            </select>

          </div>


          <!-- TRANSPORTADORA -->
          <div>

            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">
              Transportadora
            </label>

            <input
              type="text"
              name="carrier"
              value="<%= order.carrier || '' %>"
              placeholder="Ex: Logística Própria, Correios"
              class="w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-blue-500"
            >

          </div>


          <!-- CÓDIGO DE RASTREIO -->
          <div>

            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">
              Código de Rastreio
            </label>

            <input
              type="text"
              name="trackingCode"
              value="<%= order.trackingCode || '' %>"
              placeholder="Ex: TRK-1042BR"
              class="w-full bg-white border border-slate-300 text-slate-800 text-sm rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-blue-500"
            >

          </div>


          <!-- NOTIFICAR CLIENTE -->
          <div class="flex items-center gap-2 pt-1">

            <input
              type="checkbox"
              id="notifyClient"
              name="notifyClient"
              value="true"
              checked
              class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
            >

            <label
              for="notifyClient"
              class="text-xs text-slate-600 cursor-pointer"
            >
              Notificar cliente (Telegram / WhatsApp)
            </label>

          </div>


          <!-- BOTÃO -->
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg text-sm transition-all shadow-sm"
          >
            Atualizar Pedido
          </button>

        </form>


        <!-- ========================================== -->
        <!-- ENTREGADOR ASSOCIADO -->
        <!-- ========================================== -->

        <% if (
          activeDelivery &&
          activeDelivery.driver
        ) { %>

          <div class="p-3 bg-blue-50 border border-blue-100 rounded-lg flex items-center justify-between gap-3 text-sm mt-4">

            <div>

              <p class="font-bold text-blue-900">
                <%= activeDelivery.driver.name %>
              </p>

              <p class="text-xs text-blue-700">
                📱
                <%= activeDelivery.driver.phone || 'Sem telefone' %>

                |

                🛵
                <%= activeDelivery.driver.vehicle || 'Sem veículo' %>
              </p>


              <% if (
                activeDelivery.driver.lastLocationAt
              ) { %>

                <p class="text-[11px] text-blue-500 mt-1">
                  Última localização:
                  <%= new Date(
                    activeDelivery.driver.lastLocationAt
                  ).toLocaleString('pt-BR') %>
                </p>

              <% } %>

            </div>


            <% if (
              activeDelivery.driver.phone
            ) { %>

              <a
                href="/api/gps/map/<%= encodeURIComponent(activeDelivery.driver.phone) %>"
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 text-xs font-semibold text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1"
              >
                <i class="fas fa-location-dot"></i>
                Ver no Mapa
              </a>

            <% } %>

          </div>

        <% } %>


        <% if (
          !activeDelivery ||
          !activeDelivery.driver
        ) { %>

          <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-500">

            Nenhum entregador associado ao pedido.

          </div>

        <% } %>


      </div>

    </div>

  </div>

</div>
