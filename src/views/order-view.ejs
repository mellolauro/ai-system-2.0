<div class="max-w-4xl mx-auto space-y-6">
  <!-- Topo com Navegação e Ações -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <a href="/orders" class="text-sm font-semibold text-blue-600 hover:underline flex items-center gap-1.5 mb-2">
        <i class="fas fa-arrow-left text-xs"></i> Voltar aos Pedidos
      </a>
      <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-3">
        Pedido #<%= order.id.slice(-8).toUpperCase() %>
      </h1>
      <p class="text-xs text-slate-400 mt-0.5">Criado em <%= new Date(order.createdAt).toLocaleString('pt-BR') %></p>
    </div>

    <div class="flex items-center gap-3">
      <a href="/orders/print/<%= order.id %>" target="_blank" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg text-sm transition flex items-center gap-2 border border-slate-300">
        <i class="fas fa-print"></i> Imprimir Recibo
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Coluna Esquerda: Itens do Pedido (2 Colunas) -->
    <div class="md:col-span-2 bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-6">
      <h2 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-3">Itens do Pedido</h2>

      <div class="divide-y divide-slate-100">
        <% if (order.items && order.items.length > 0) { %>
          <% order.items.forEach(item => { %>
            <div class="py-3 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400 font-bold text-xs border">
                  <%= item.quantity %>x
                </div>
                <div>
                  <h3 class="font-semibold text-sm text-slate-800">
                    <%= item.productName || (item.product ? item.product.name : 'Produto') %>
                  </h3>
                  <p class="text-xs text-slate-400">R$ <%= item.price.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %> un.</p>
                </div>
              </div>
              <span class="font-bold text-sm text-slate-800">
                R$ <%= (item.price * item.quantity).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
              </span>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-sm text-slate-400 py-4 italic">Nenhum item registrado.</p>
        <% } %>
      </div>

      <!-- Resumo Financeiro -->
      <div class="pt-4 border-t border-slate-100 space-y-2">
        <div class="flex justify-between text-sm text-slate-600">
          <span>Subtotal</span>
          <span>R$ <%= Number(order.total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
        </div>
        <div class="flex justify-between text-sm text-slate-600">
          <span>Frete</span>
          <span class="text-emerald-600 font-semibold">Grátis</span>
        </div>
        <div class="flex justify-between text-base font-bold text-slate-800 pt-2 border-t border-slate-200">
          <span>Total do Pedido</span>
          <span class="text-indigo-600">R$ <%= Number(order.total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
        </div>
      </div>
    </div>

    <!-- Coluna Direita: Status, Logística e Cliente (1 Coluna) -->
    <div class="space-y-6">

      <!-- Informações do Cliente -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-3">
        <h3 class="text-xs font-bold uppercase text-slate-400 tracking-wider">Dados do Cliente</h3>
        <div>
          <p class="font-bold text-slate-800 text-sm"><%= order.user ? order.user.name : 'N/A' %></p>
          <p class="text-xs text-slate-500 mt-0.5"><%= order.user && order.user.email ? order.user.email : 'Sem e-mail' %></p>
          <% if (order.user && order.user.phone) { %>
            <p class="text-xs text-slate-500 mt-0.5"><i class="fab fa-whatsapp text-emerald-600 mr-1"></i> <%= order.user.phone %></p>
          <% } %>
          <% if (order.user && order.user.telegramId) { %>
            <p class="text-xs text-slate-500 mt-0.5"><i class="fab fa-telegram text-blue-500 mr-1"></i> ID: <%= order.user.telegramId %></p>
          <% } %>
        </div>
      </div>

      <!-- Formulário Logística & Envio -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
        <h3 class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-4">Logística & Envio</h3>

        <form action="/orders/update-status/<%= order.id %>" method="POST" class="space-y-4">

          <!-- Status do Pedido -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Status do Pedido</label>
            <select id="statusSelect" name="status" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-500" onchange="toggleCancelReason()">
              <option value="PENDING" <%= order.status === 'PENDING' ? 'selected' : '' %>>PENDING (Pendente)</option>
              <option value="PROCESSING" <%= order.status === 'PROCESSING' ? 'selected' : '' %>>PROCESSING (Em Separação)</option>
              <option value="SHIPPED" <%= order.status === 'SHIPPED' ? 'selected' : '' %>>SHIPPED (Enviado)</option>
              <option value="DELIVERED" <%= order.status === 'DELIVERED' ? 'selected' : '' %>>DELIVERED (Entregue)</option>
              <option value="CANCELLED" <%= order.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED (Cancelado)</option>
            </select>
          </div>

          <!-- Campo Dinâmico: Motivo do Cancelamento -->
          <div id="cancelReasonBox" class="<%= order.status === 'CANCELLED' ? '' : 'hidden' %>">
            <label class="block text-xs font-semibold text-red-600 mb-1">Motivo do Cancelamento</label>
            <input 
              type="text" 
              name="cancelReason" 
              maxLength="150"
              value="<%= order.cancelReason || '' %>" 
              placeholder="Ex: Peça indisponível, Cliente desistiu"
              class="w-full px-3 py-2 border border-red-300 rounded-lg text-sm bg-red-50 focus:bg-white focus:outline-none focus:border-red-500"
            />
          </div>

          <!-- Status do Pagamento -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Status do Pagamento</label>
            <select name="paymentStatus" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-500">
              <option value="PENDING" <%= order.paymentStatus === 'PENDING' ? 'selected' : '' %>>PENDING (Aguardando)</option>
              <option value="PAID" <%= order.paymentStatus === 'PAID' ? 'selected' : '' %>>PAID (Pago)</option>
              <option value="REFUNDED" <%= order.paymentStatus === 'REFUNDED' ? 'selected' : '' %>>REFUNDED (Reembolsado)</option>
            </select>
          </div>

          <!-- Transportadora -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Transportadora</label>
            <input
              type="text"
              name="carrier"
              value="<%= order.carrier || 'Correios' %>"
              placeholder="Ex: Correios, Jadlog"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500"
            />
          </div>

          <!-- Código de Rastreio -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Código de Rastreio</label>
            <input
              type="text"
              name="trackingCode"
              value="<%= order.trackingCode || '' %>"
              placeholder="Ex: AA123456789BR"
              class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 font-mono uppercase"
            />
          </div>

          <!-- Checkbox para notificar o cliente -->
          <div class="flex items-center gap-2 pt-2">
            <input
              type="checkbox"
              id="notifyClient"
              name="notifyClient"
              checked
              class="w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500"
            >
            <label for="notifyClient" class="text-xs text-slate-600 font-medium cursor-pointer">
              Notificar cliente (Telegram / WhatsApp)
            </label>
          </div>

          <!-- Botão de Salvar -->
          <button type="submit" class="w-full mt-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg text-sm transition-colors shadow-sm">
            Atualizar Pedido
          </button>
        </form>
      </div>

      <!-- Ação: Ocultar Pedido da Listagem (Soft Delete) -->
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-4">
        <form action="/orders/hide/<%= order.id %>" method="POST" onsubmit="return confirm('Ocultar este pedido da listagem principal? (Ele permanecerá no banco de dados para relatórios)');">
          <button type="submit" class="w-full bg-white hover:bg-slate-100 text-slate-600 font-semibold py-2 px-3 rounded-lg text-xs border border-slate-300 transition flex items-center justify-center gap-2">
            <i class="fas fa-eye-slash text-slate-400"></i> Ocultar Pedido da Lista
          </button>
        </form>
      </div>

    </div>

  </div>
</div>

<script>
  function toggleCancelReason() {
    const select = document.getElementById('statusSelect');
    const box = document.getElementById('cancelReasonBox');
    if (select.value === 'CANCELLED') {
      box.classList.remove('hidden');
    } else {
      box.classList.add('hidden');
    }
  }
</script>
