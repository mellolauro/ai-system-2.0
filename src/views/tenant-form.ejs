<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/tenants" class="text-blue-600 text-sm hover:underline">
            <i class="fas fa-arrow-left"></i> Voltar
        </a>

        <h1 class="text-2xl font-bold text-slate-800 mt-2">
            <%= typeof tenant !== 'undefined' && tenant
                ? "Editar Empresa"
                : "Configurar Nova Empresa"
            %>
        </h1>
    </div>

    <form
        action="<%= typeof tenant !== 'undefined' && tenant
            ? '/tenants/update/' + tenant.id
            : '/tenants/create'
        %>"
        method="POST"
        class="bg-white p-8 rounded-xl shadow-lg border border-slate-200"
    >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="space-y-6">

            <!-- EMPRESA -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">
                    Nome da Empresa
                </label>

                <input
                    name="name"
                    type="text"
                    placeholder="Ex: Tecno Shopping"
                    value="<%= typeof tenant !== 'undefined' && tenant
                        ? tenant.name
                        : ''
                    %>"
                    class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                    required
                >
            </div>

            <!-- PLANO / AGENTE -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        Plano de Serviço
                    </label>

                    <select
                        name="plan"
                        class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white"
                    >
                        <option
                            value="free"
                            <%= (
                                typeof tenant !== 'undefined' &&
                                tenant?.plan === 'free'
                            ) ? 'selected' : '' %>
                        >
                            Free (Básico)
                        </option>

                        <option
                            value="pro"
                            <%= (
                                typeof tenant !== 'undefined' &&
                                tenant?.plan === 'pro'
                            ) ? 'selected' : '' %>
                        >
                            Pro (Ilimitado)
                        </option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        Nome do Agente AI
                    </label>

                    <input
                        name="agentName"
                        type="text"
                        value="<%= typeof tenant !== 'undefined' && tenant
                            ? tenant.agentName
                            : 'main'
                        %>"
                        class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                    >
                </div>

            </div>

            <!-- ENDEREÇO OPERACIONAL -->
            <div class="border-t border-slate-200 pt-6">

                <h2 class="text-lg font-bold text-slate-800 mb-1">
                    Endereço Operacional
                </h2>

                <p class="text-sm text-slate-500 mb-5">
                    Este endereço será utilizado como origem das entregas.
                </p>

                <div class="space-y-4">

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            Endereço
                        </label>

                        <input
                            name="addressLine"
                            type="text"
                            placeholder="Ex: Av. Brasil, 1500 - Loja 10"
                            value="<%= typeof tenant !== 'undefined' &&
                                tenant?.addressLine
                                ? tenant.addressLine
                                : ''
                            %>"
                            class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                        >
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">
                                Cidade
                            </label>

                            <input
                                name="city"
                                type="text"
                                placeholder="Cidade"
                                value="<%= typeof tenant !== 'undefined' &&
                                    tenant?.city
                                    ? tenant.city
                                    : ''
                                %>"
                                class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                            >
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">
                                Estado
                            </label>

                            <input
                                name="state"
                                type="text"
                                maxlength="2"
                                placeholder="RJ"
                                value="<%= typeof tenant !== 'undefined' &&
                                    tenant?.state
                                    ? tenant.state
                                    : ''
                                %>"
                                class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none uppercase"
                            >
                        </div>

                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            CEP
                        </label>

                        <input
                            name="zipCode"
                            type="text"
                            placeholder="00000-000"
                            value="<%= typeof tenant !== 'undefined' &&
                                tenant?.zipCode
                                ? tenant.zipCode
                                : ''
                            %>"
                            class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                        >
                    </div>

                </div>
            </div>

            <!-- INFORMAÇÃO -->
            <div class="p-4 bg-blue-50 rounded-lg flex items-start gap-3">
                <i class="fas fa-info-circle text-blue-500 mt-1"></i>

                <p class="text-xs text-blue-700">
                    O Tenant é a entidade principal. Todos os usuários,
                    produtos, pedidos e entregas serão vinculados a esta
                    empresa. O endereço operacional será utilizado como
                    origem das entregas.
                </p>
            </div>

            <button
                type="submit"
                class="w-full bg-slate-900 hover:bg-black text-white font-bold py-3 rounded-lg transition-all shadow-md"
            >
                <%= typeof tenant !== 'undefined' && tenant
                    ? "Atualizar Dados"
                    : "Criar Tenant"
                %>
            </button>

        </div>
    </form>
</div>
