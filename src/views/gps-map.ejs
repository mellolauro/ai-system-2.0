<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rastreamento GPS - <%= driver.name %></title>

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body, html {
      height: 100%;
      width: 100%;
      font-family: Arial, sans-serif;
    }
    #map {
      height: 100%;
      width: 100%;
      z-index: 1;
    }
    .info-card {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.95);
      padding: 16px 20px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      max-width: 320px;
      backdrop-filter: blur(5px);
    }
    .info-card h2 {
      font-size: 1.1rem;
      color: #1f2937;
      margin-bottom: 6px;
    }
    .info-card p {
      font-size: 0.875rem;
      color: #4b5563;
      margin-bottom: 4px;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      font-weight: bold;
      color: #059669;
      background: #ecfdf5;
      padding: 4px 8px;
      border-radius: 20px;
      margin-top: 8px;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
  </style>
</head>
<body>

  <div class="info-card">
    <h2>🛵 <%= driver.name %></h2>
    <p><strong>Veículo:</strong> <%= driver.vehicle || 'Não informado' %> (<%= driver.plate || 'Sem placa' %>)</p>
    <p><strong>Telefone:</strong> <%= driver.phone %></p>
    <div class="status-badge">
      <div class="pulse-dot"></div> Rastreamento em Tempo Real
    </div>
  </div>

  <div id="map"></div>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    const driverPhone = "<%= driver.phone %>";
    let initialLat = <%= driver.latitude || -22.7561 %>;
    let initialLng = <%= driver.longitude || -43.4602 %>;

    // Inicializa o mapa com Leaflet (OpenStreetMap)
    const map = L.map('map').setView([initialLat, initialLng], 16);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // Ícone personalizado para o entregador
    const driverIcon = L.icon({
      iconUrl: 'https://cdn-icons-png.flaticon.com/512/2972/2972531.png',
      iconSize: [42, 42],
      iconAnchor: [21, 21],
      popupAnchor: [0, -20]
    });

    const marker = L.marker([initialLat, initialLng], { icon: driverIcon }).addTo(map);
    marker.bindPopup("<b><%= driver.name %></b><br>Em trânsito").openPopup();

    // Função para atualizar a posição no mapa a cada 3s (Polling)
    async function updateMapPosition() {
      try {
        const response = await fetch(`/api/gps/location/${driverPhone}`);
        const data = await response.json();

        if (data.success && data.latitude && data.longitude) {
          const newPos = [data.latitude, data.longitude];
          
          // Move o marcador suavemente e re-centraliza o mapa
          marker.setLatLng(newPos);
          map.panTo(newPos, { animate: true, duration: 1.0 });
        }
      } catch (err) {
        console.error("Erro ao atualizar posição GPS:", err);
      }
    }

    setInterval(updateMapPosition, 3000);
  </script>
</body>
</html>
