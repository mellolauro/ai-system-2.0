<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Recibo - Pedido #<%= order.id.slice(-8).toUpperCase() %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none; }
      body { background: white; color: black; }
    }
  </style>
</head>
<body class="bg-slate-100 p-6 md:p-12 font-sans text-slate-800" onload="window.print()">

  <div class="max-w-2xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
    <!-- Cabeçalho -->
    <div class="flex justify-between items-start border-b border-slate-200 pb-6 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= order.tenant ? order.tenant.name : 'Nexus AI System' %></h1>
        <p class="text-xs text-slate-500 mt-1">Comprovante de Compra / Pedido Autônomo</p>
      </div>
      <div class="text-right">
        <span class="font-mono font-bold text-base text-slate-900">#<%= order.id.slice(-8).toUpperCase() %></span>
        <p class="text-xs text-slate-500 mt-1"><%= new Date(order.createdAt).toLocaleDateString('pt-BR') %></p>
      </div>
    </div>

    <!-- Cliente & Envio -->
    <div class="grid grid-cols-2 gap-4 text-xs mb-6 pb-6 border-b border-slate-200">
      <div>
        <h3 class="font-bold text-slate-400 uppercase mb-1">Cliente</h3>
        <p class="font-semibold text-slate-800 text-sm"><%= order.user ? order.user.name : 'N/A' %></p>
        <p class="text-slate-500"><%= order.user && order.user.email ? order.user.email : '' %></p>
        <p class="text-slate-500"><%= order.user && order.user.phone ? order.user.phone : '' %></p>
      </div>
      <div class="text-right">
        <h3 class="font-bold text-slate-400 uppercase mb-1">Pagamento & Envio</h3>
        <p class="font-semibold text-slate-800">Status: <%= order.status %></p>
        <p class="text-slate-500">Pagamento: <%= order.paymentStatus %></p>
        <% if (order.trackingCode) { %>
          <p class="font-mono text-slate-700 mt-1">Rastreio: <%= order.trackingCode %> (<%= order.carrier || 'Correios' %>)</p>
        <% } %>
      </div>
    </div>

    <!-- Tabela de Produtos -->
    <table class="w-full text-left text-xs mb-6">
      <thead>
        <tr class="border-b border-slate-200 text-slate-400 uppercase font-semibold">
          <th class="py-2">Item</th>
          <th class="py-2 text-center">Qtd</th>
          <th class="py-2 text-right">Preço Un.</th>
          <th class="py-2 text-right">Subtotal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (order.items && order.items.length > 0) { %>
          <% order.items.forEach(item => { %>
            <tr>
              <td class="py-3 font-medium text-slate-800"><%= item.productName || (item.product ? item.product.name : 'Item') %></td>
              <td class="py-3 text-center"><%= item.quantity %></td>
              <td class="py-3 text-right">R$ <%= item.price.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
              <td class="py-3 text-right font-semibold">R$ <%= (item.price * item.quantity).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>

    <!-- Total -->
    <div class="border-t border-slate-200 pt-4 flex justify-between items-center text-sm">
      <span class="font-bold text-slate-700">VALOR TOTAL</span>
      <span class="font-bold text-xl text-slate-900">R$ <%= Number(order.total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
    </div>

    <!-- Botões de Controle na Tela (ocultos na impressão) -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end gap-3 no-print">
      <button onclick="window.close()" class="px-4 py-2 border rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-50">Fechar</button>
      <button onclick="window.print()" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700">Imprimir Novamente</button>
    </div>
  </div>

</body>
</html>
