<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Catálogo de Produtos</h1>

    <a href="/products/new"
       class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-all shadow-md flex items-center gap-2">
        <i class="fas fa-plus"></i>
        Novo Produto
    </a>
</div>

<% if (query && query.success === "product_deleted") { %>
    <div class="mb-6 p-4 rounded-lg border border-green-200 bg-green-50 text-green-800">
        Produto excluído com sucesso.
    </div>
<% } %>

<% if (query && query.success === "product_activated") { %>
    <div class="mb-6 p-4 rounded-lg border border-green-200 bg-green-50 text-green-800">
        Produto reativado com sucesso.
    </div>
<% } %>

<% if (query && query.success === "product_deactivated") { %>
    <div class="mb-6 p-4 rounded-lg border border-amber-200 bg-amber-50 text-amber-800">
        O produto possui histórico de pedidos e foi desativado para preservar esse histórico.
    </div>
<% } %>

<% if (query && query.error === "product_not_found") { %>
    <div class="mb-6 p-4 rounded-lg border border-red-200 bg-red-50 text-red-800">
        Produto não encontrado.
    </div>
<% } %>

<% if (query && query.error === "invalid_price") { %>
    <div class="mb-6 p-4 rounded-lg border border-red-200 bg-red-50 text-red-800">
        Informe um preço de venda válido, maior ou igual a zero.
    </div>
<% } %>

<% if (query && query.error === "invalid_cost_price") { %>
    <div class="mb-6 p-4 rounded-lg border border-red-200 bg-red-50 text-red-800">
        Informe um preço de custo válido, maior ou igual a zero.
    </div>
<% } %>

<% if (query && query.error === "invalid_stock") { %>
    <div class="mb-6 p-4 rounded-lg border border-red-200 bg-red-50 text-red-800">
        Informe um estoque inteiro, maior ou igual a zero.
    </div>
<% } %>

<div class="bg-white rounded-xl shadow-sm overflow-hidden border border-slate-200">
    <table class="w-full text-left border-collapse">

        <thead class="bg-slate-50">
            <tr>
                <th class="p-4 font-semibold text-slate-600 border-b">Produto</th>
                <th class="p-4 font-semibold text-slate-600 border-b">Preço</th>
                <th class="p-4 font-semibold text-slate-600 border-b">Estoque</th>
                <th class="p-4 font-semibold text-slate-600 border-b">Status</th>
                <th class="p-4 font-semibold text-slate-600 border-b">Ações</th>
            </tr>
        </thead>

        <tbody>

        <% products.forEach(p => { %>

            <tr class="hover:bg-slate-50 transition-colors border-b last:border-0">

                <!-- PRODUTO -->
                <td class="p-4 flex items-center gap-4">

                 <div class="w-12 h-12 rounded-lg bg-slate-100 overflow-hidden border flex items-center justify-center">
                   <% 
                     const photoUrl = (p.images && p.images.length > 0) ? p.images[0].url : p.imageUrl;
                   %>
                   <% if (photoUrl) { %>
                     <img 
                       src="<%= photoUrl %>" 
                       alt="<%= p.name %>"
                       class="w-full h-full object-cover"
                       onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                     />
                     <div class="w-full h-full hidden items-center justify-center text-slate-400 text-[10px] font-medium bg-slate-100">
                       Sem foto
                     </div>
                   <% } else { %>
                     <div class="w-full h-full flex items-center justify-center text-slate-400 text-[10px] font-medium bg-slate-100">
                       Sem foto
                     </div>
                   <% } %>
                 </div>
                    <span class="font-medium text-slate-700">
                        <%= p.name %>
                    </span>

                </td>

                <!-- PREÇO -->
                <td class="p-4 text-slate-600 font-semibold">
                    R$ <%= p.price.toLocaleString('pt-BR',{minimumFractionDigits:2}) %>
                </td>

                <!-- ESTOQUE -->
                <td class="p-4">

                    <span class="px-3 py-1 rounded-full text-xs font-bold
                    <%= p.stock > 5 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">

                        <%= p.stock %> unidades

                    </span>

                </td>

                <!-- STATUS -->
                <td class="p-4">
                    <% if (p.active) { %>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                            Ativo
                        </span>
                    <% } else { %>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-600">
                            Inativo
                        </span>
                    <% } %>
                </td>

                <!-- AÇÕES -->
                <td class="p-4 flex gap-4">

                    <!-- EDITAR -->
                    <a href="/products/edit/<%= p.id %>"
                       class="text-blue-600 hover:text-blue-800">

                        <i class="fas fa-edit"></i>

                    </a>

                    <% if (p.active) { %>

                        <!-- REMOVER / DESATIVAR -->
                        <form
                            action="/products/delete/<%= p.id %>"
                            method="POST"
                            class="inline"
                            onsubmit="return confirm('Deseja remover este produto do catálogo? Produtos com histórico de pedidos serão apenas desativados.')"
                        >
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <button
                                type="submit"
                                class="text-red-600 hover:text-red-800"
                                title="Remover produto"
                            >
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>

                    <% } else { %>

                        <!-- REATIVAR -->
                        <form
                            action="/products/activate/<%= p.id %>"
                            method="POST"
                            class="inline"
                            onsubmit="return confirm('Deseja reativar este produto no catálogo?')"
                        >
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <button
                                type="submit"
                                class="text-green-600 hover:text-green-800"
                                title="Reativar produto"
                            >
                                <i class="fas fa-rotate-left"></i>
                            </button>
                        </form>

                    <% } %>

                </td>

            </tr>

        <% }) %>

        </tbody>

    </table>
</div>
