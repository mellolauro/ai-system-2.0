<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NexusAI 2.0 — Sistema Autônomo de Vendas & Agentes Inteligentes</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white font-sans">

  <!-- Header -->
  <header class="fixed top-0 w-full z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30">
          <i class="fa-solid fa-microchip text-lg"></i>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-white">AI-System <span class="text-indigo-400">2.0</span></span>
          <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full">OpenClaw Provider</span>
        </div>
      </div>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="#agents" class="hover:text-indigo-400 transition">Agentes</a>
        <a href="#tools" class="hover:text-indigo-400 transition">Ferramentas</a>
        <a href="#catalog" class="hover:text-indigo-400 transition">Catálogo</a>
        <a href="#pricing" class="hover:text-indigo-400 transition">Planos</a>
      </nav>

      <div class="flex items-center gap-4">
        <a href="/dashboard" class="text-sm font-semibold text-slate-300 hover:text-white transition">Painel</a>
        <a href="/dashboard" class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition shadow-lg shadow-indigo-600/25">Acessar App</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative pt-36 pb-20 overflow-hidden">
    <div class="absolute inset-0 -z-10 flex items-center justify-center">
      <div class="w-[600px] h-[600px] bg-indigo-500/10 blur-[150px] rounded-full"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-300 text-xs font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> 5 Agentes Especializados + 11 Tools Ativas
      </div>
      
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
        Automação de E-commerce com <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-violet-400">IA de Ação Completa</span>
      </h1>
      
      <p class="mt-6 text-lg md:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Do primeiro contato no WhatsApp ao despacho logístico nos Correios. Seus agentes consultam catálogo, gerenciam carrinhos, disparam pedidos e rastreiam encomendas de forma 100% autônoma.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/dashboard" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition shadow-xl shadow-indigo-600/30 flex items-center justify-center gap-2">
          <span>Acessar Painel Multi-Tenant</span>
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
        <a href="#tools" class="w-full sm:w-auto px-8 py-4 rounded-xl border border-slate-800 hover:bg-slate-900 text-slate-300 font-semibold transition">
          Ver Capacidades das Tools
        </a>
      </div>
    </div>
  </section>

  <!-- Seção 5 Agentes Especializados -->
  <section id="agents" class="py-20 border-t border-slate-900 bg-slate-950/60">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-3xl font-bold text-white">Cluster com 5 Agentes Especialistas</h2>
        <p class="mt-3 text-slate-400">Roteamento contextual automático executado via OpenClaw Provider.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="p-5 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="w-10 h-10 mx-auto rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-lg mb-3">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Sales Agent</h3>
          <p class="text-xs text-slate-400 mt-2">Negociação, checkout, recuperação de carrinho e conversão.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="w-10 h-10 mx-auto rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center text-lg mb-3">
            <i class="fa-solid fa-box-open"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Product Agent</h3>
          <p class="text-xs text-slate-400 mt-2">Busca profunda de catálogo, estoque, especificações e variantes.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="w-10 h-10 mx-auto rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center text-lg mb-3">
            <i class="fa-solid fa-headset"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Support Agent</h3>
          <p class="text-xs text-slate-400 mt-2">Status de entregas, rastreio de código e cancelamentos.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="w-10 h-10 mx-auto rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-lg mb-3">
            <i class="fa-solid fa-chart-pie"></i>
          </div>
          <h3 class="font-bold text-white text-sm">AI Data Agent</h3>
          <p class="text-xs text-slate-400 mt-2">Processamento de memória persistente e histórico de usuário.</p>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/80 border border-slate-800 text-center sm:col-span-2 lg:col-span-1">
          <div class="w-10 h-10 mx-auto rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-lg mb-3">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Fallback Agent</h3>
          <p class="text-xs text-slate-400 mt-2">Tratamento de exceções, intents ambíguos e fallback seguro.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 11 Tools / Capacidades de Ação -->
  <section id="tools" class="py-20 border-t border-slate-900 bg-slate-950">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-3xl font-bold text-white">11 Ferramentas com Execução Real em Banco</h2>
        <p class="mt-3 text-slate-400">A IA não apenas responde texto: ela executa queries, atualiza estados e opera pipelines de frete.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-magnifying-glass text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">searchProducts</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-tag text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">getProduct</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-cart-plus text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">addToCart</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-credit-card text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">checkoutCart</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-file-invoice text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">createOrder</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-clock-rotate-left text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">getLatestOrder</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-receipt text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">getOrder</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-truck-fast text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">shipOrder</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-box-check text-indigo-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">deliverOrder</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3">
          <i class="fa-solid fa-ban text-rose-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">cancelOrder</span>
        </div>
        <div class="p-4 rounded-lg bg-slate-900/50 border border-slate-800 flex items-center gap-3 col-span-2 sm:col-span-1 lg:col-span-2">
          <i class="fa-solid fa-money-bill-transfer text-emerald-400 text-sm"></i>
          <span class="text-xs font-mono text-slate-300">updatePaymentStatus</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Vitrine de Produtos Dinâmica do Prisma -->
  <section id="catalog" class="py-20 border-t border-slate-900 bg-slate-950/40">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-white">Catálogo de Produtos em Tempo Real</h2>
        <p class="mt-2 text-slate-400">Itens integrados ao fluxo dos agentes e disponíveis no banco.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="bg-slate-900/80 border border-slate-800 rounded-xl overflow-hidden flex flex-col justify-between hover:border-indigo-500/40 transition">
              <div class="h-44 bg-slate-950 flex items-center justify-center p-3 relative overflow-hidden">
                <% const pUrl = (product.images && product.images.length > 0) ? product.images[0].url : product.imageUrl; %>
                <% if (pUrl) { %>
                  <img 
                    src="<%= pUrl %>" 
                    alt="<%= product.name %>" 
                    class="max-h-full max-w-full object-contain"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="w-full h-full hidden items-center justify-center text-slate-500 text-xs font-medium bg-slate-950">
                    <i class="fa-regular fa-image mr-1"></i> Sem imagem
                  </div>
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-slate-500 text-xs font-medium bg-slate-950">
                    <i class="fa-regular fa-image mr-1"></i> Sem imagem
                  </div>
                <% } %>
              </div>
              
              <div class="p-5 flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="text-sm font-semibold text-white truncate" title="<%= product.name %>"><%= product.name %></h3>
                  <div class="mt-2 flex items-center justify-between text-xs">
                    <span class="text-slate-400">Estoque: <%= product.stock %> un</span>
                    <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">Disponível</span>
                  </div>
                </div>
                
                <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between">
                  <span class="text-base font-bold text-indigo-400">
                    R$ <%= product.price.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                  </span>
                  <a href="/dashboard" class="text-xs text-slate-400 hover:text-white transition flex items-center gap-1">
                    Comprar via IA <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full py-12 text-center text-slate-500">
            <i class="fa-solid fa-box-open text-3xl mb-3 block"></i>
            Nenhum produto cadastrado no momento.
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-24 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white">Planos Multi-Tenant</h2>
        <p class="mt-3 text-slate-400">Alocação de tokens, canais e instâncias de agentes sob medida.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-semibold text-white">Starter</h3>
            <p class="text-3xl font-bold text-white mt-4">R$ 0 <span class="text-sm font-normal text-slate-400">/mês</span></p>
            <ul class="mt-6 space-y-3 text-sm text-slate-400">
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> 50.000 tokens inclusos</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> 1 Agente de Atendimento</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> Catálogo até 50 produtos</li>
            </ul>
          </div>
          <a href="/dashboard" class="mt-8 block text-center py-3 rounded-lg border border-slate-700 hover:bg-slate-800 font-semibold text-sm transition">Iniciar Free</a>
        </div>

        <div class="p-8 rounded-2xl bg-gradient-to-b from-indigo-950/40 to-slate-900 border-2 border-indigo-500 flex flex-col justify-between relative shadow-2xl shadow-indigo-500/10">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-600 text-white text-xs uppercase tracking-wider font-bold py-1 px-3 rounded-full">Pro Enterprise</span>
          <div>
            <h3 class="text-lg font-semibold text-white">Professional</h3>
            <p class="text-3xl font-bold text-white mt-4">R$ 197 <span class="text-sm font-normal text-slate-400">/mês</span></p>
            <ul class="mt-6 space-y-3 text-sm text-slate-300">
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> 500.000 tokens inclusos</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> 5 Agentes Especialistas Ativos</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> Todas as 11 Tools de Ação</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> WhatsApp & Telegram Ilimitados</li>
            </ul>
          </div>
          <a href="/dashboard" class="mt-8 block text-center py-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 font-semibold text-sm transition text-white">Criar Tenant Pro</a>
        </div>

        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-semibold text-white">Enterprise</h3>
            <p class="text-3xl font-bold text-white mt-4">Custom</p>
            <ul class="mt-6 space-y-3 text-sm text-slate-400">
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> Tokens dedicados ilimitados</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> Gateway e LLM Dedicado</li>
              <li><i class="fa-solid fa-check text-indigo-400 mr-2"></i> SLA 99.9% e Suporte 24/7</li>
            </ul>
          </div>
          <a href="/dashboard" class="mt-8 block text-center py-3 rounded-lg border border-slate-700 hover:bg-slate-800 font-semibold text-sm transition">Contatar Vendas</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-slate-900 py-10 bg-slate-950">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© 2026 AI-System 2.0 (OpenClaw Multi-Agent Architecture). Todos os direitos reservados.</p>
      <div class="flex gap-6">
        <a href="/health" class="hover:text-slate-400">Status da API</a>
        <a href="/dashboard" class="hover:text-slate-400">Painel de Controle</a>
      </div>
    </div>
  </footer>

</body>
</html>
