const axios = require("axios");
const path = require("path");

const Provider =
    require("./Provider");

const ToolManager =
    require("../core/ToolManager");

class OpenClawProvider extends Provider {

    constructor(config = {}) {

        super({
            name:
                config.name ||
                "openclaw"
        });

        this.baseUrl = (
            config.baseUrl ||
            process.env.OPENCLAW_URL ||
            "http://127.0.0.1:18789"
        ).replace(/\/$/, "");

        this.token =
            config.token ||
            process.env.OPENCLAW_TOKEN;

        this.agentTarget =
            config.agentTarget ||
            "openclaw/default";

        this.timeout =
            Number(
                config.timeout ||
                process.env.DEFAULT_TIMEOUT ||
                60000
            );

        this.maxToolCalls =
            Number(
                config.maxToolCalls ||
                process.env.MAX_TOOL_CALLS ||
                8
            );

        /*
         * Diretório público do AI-System.
         *
         * As imagens cadastradas no banco possuem
         * caminhos como:
         *
         * /uploads/products/foto.jpg
         *
         * O OpenClaw precisa receber um caminho
         * que realmente exista no filesystem.
         */
        this.publicDir =
            config.publicDir ||
            process.env.AI_SYSTEM_PUBLIC_DIR ||
            path.resolve(
                process.cwd(),
                "public"
            );

        this.http =
            axios.create({

                baseURL:
                    `${this.baseUrl}/v1`,

                timeout:
                    this.timeout,

                headers: {

                    Authorization:
                        `Bearer ${this.token}`,

                    "Content-Type":
                        "application/json",

                    Accept:
                        "application/json"

                }

            });

    }

    async initialize() {

        if (!this.token) {

            throw new Error(
                "OPENCLAW_TOKEN não configurado."
            );

        }

        try {

            const health =
                await this.health();

            console.log(
                `[OpenClawProvider] ✅ Gateway HTTP disponível (${health.status})`
            );

            return true;

        } catch (error) {

            console.error(
                "[OpenClawProvider] ❌ Falha ao conectar ao Gateway:",
                error.message
            );

            throw error;

        }

    }

    async generate(request = {}) {

        const {

            messages = [],

            session = "main",

            agent,

            temperature,

            maxTokens,

            tools = [],

            tenantId,

            userId,

            userRole,

            tenantName,

            channel,

            permissions = [],

            stream = false

        } = request;

        /*
         * Resolve o agente do AI-System
         * para o target OpenClaw.
         */
        const model =
            request.agentTarget ||
            this.resolveAgentTarget(
                agent
            );

        /*
         * Não altera o array original.
         */
        const conversationMessages =
            Array.isArray(messages)
                ? [...messages]
                : [];

        /*
         * Mídias encontradas durante
         * o ciclo de Tool Calling.
         */
        const media = [];

        /*
         * Tools no formato OpenAI.
         */
        const toolDefinitions =
            this.normalizeTools(
                tools
            );

        /*
         * Contexto confiável da aplicação.
         */
        const toolContext = {

            tenantId,

            userId,

            userRole,

            tenantName,

            channel,

            sessionId:
                this.resolveSessionId(
                    session
                ),

            permissions

        };

        /*
         * Cada execução do AI-System utiliza uma
         * identidade OpenClaw nova.
         *
         * A mesma identidade é mantida durante
         * todos os rounds de Tool Calling da
         * requisição atual.
         *
         * Isso evita o acúmulo de contexto
         * entre requisições independentes.
         */
        const openClawRequestUser =
            `${this.buildSessionUser(session)}:request:${Date.now()}`;

        console.log(
            "[OpenClawProvider][REQUEST_USER]",
            openClawRequestUser
        );

        console.log(
            `[OpenClawProvider] 🚀 Agent: ${agent || "unknown"}`
        );

        console.log(
            `[OpenClawProvider] 🎯 Target: ${model}`
        );

        console.log(
            `[OpenClawProvider] 🔧 Tools disponíveis: ${toolDefinitions.length}`
        );

        /*
         * Ciclo:
         *
         * OpenClaw
         *     ↓
         * Tool Call
         *     ↓
         * ToolManager
         *     ↓
         * Resultado
         *     ↓
         * OpenClaw
         */
        for (
            let round = 0;
            round <= this.maxToolCalls;
            round++
        ) {

            const payload = {

                model,

                messages:
                    conversationMessages,

                /*
                 * Mantém a mesma sessão temporária em todos
                 * os rounds desta execução.
                 */
                user:
                    openClawRequestUser,

                stream: false

            };

            if (
                temperature !== undefined
            ) {

                payload.temperature =
                    temperature;

            }

            if (
                maxTokens !== undefined
            ) {

                payload.max_tokens =
                    maxTokens;

            }

            if (
                toolDefinitions.length > 0
            ) {

                payload.tools =
                    toolDefinitions;

                payload.tool_choice =
                    "auto";

            }

            try {

                /*
                 * =================================================
                 * CONTEXT STATS
                 * =================================================
                 *
                 * Não imprime o conteúdo completo das mensagens
                 * nem os schemas das Tools.
                 *
                 * Mede somente o tamanho aproximado do payload
                 * enviado pelo AI-System ao OpenClaw.
                 *
                 * O cálculo chars / 4 NÃO é tokenização real.
                 * É apenas uma estimativa para diagnóstico.
                 */
                const messageStats =
                    Array.isArray(
                        payload.messages
                    )
                        ? payload.messages.map(
                            (message, index) => {

                                const content =
                                    typeof message?.content ===
                                    "string"
                                        ? message.content
                                        : JSON.stringify(
                                            message?.content ??
                                            ""
                                        );

                                const toolCallsText =
                                    Array.isArray(
                                        message?.tool_calls
                                    )
                                        ? JSON.stringify(
                                            message.tool_calls
                                        )
                                        : "";

                                return {

                                    index,

                                    role:
                                        message?.role,

                                    contentChars:
                                        content.length,

                                    toolCallChars:
                                        toolCallsText.length,

                                    totalChars:
                                        content.length +
                                        toolCallsText.length

                                };

                            }
                        )
                        : [];

                const messagesChars =
                    messageStats.reduce(
                        (
                            total,
                            item
                        ) =>
                            total +
                            item.totalChars,
                        0
                    );

                const toolsJson =
                    payload.tools
                        ? JSON.stringify(
                            payload.tools
                        )
                        : "";

                const toolsChars =
                    toolsJson.length;

                const payloadJson =
                    JSON.stringify(
                        payload
                    );

                const payloadChars =
                    payloadJson.length;

                /*
                 * Estimativa grosseira:
                 *
                 * ~4 caracteres por token.
                 *
                 * Serve somente para comparar
                 * o tamanho enviado pelo AI-System
                 * com prompt_tokens reportado
                 * posteriormente pelo OpenClaw.
                 */
                const approxInputTokens =
                    Math.ceil(
                        payloadChars /
                        4
                    );

                console.log(
                    "[OpenClawProvider][CONTEXT_STATS]",
                    JSON.stringify(
                        {

                            round,

                            user:
                                payload.user,

                            messageCount:
                                messageStats.length,

                            messagesChars,

                            toolsCount:
                                Array.isArray(
                                    payload.tools
                                )
                                    ? payload.tools.length
                                    : 0,

                            toolsChars,

                            payloadChars,

                            approxInputTokens,

                            messages:
                                messageStats

                        },
                        null,
                        2
                    )
                );

                const response =
                    await this.http.post(
                        "/chat/completions",
                        payload
                    );

                const data =
                    response.data;

                const choice =
                    data
                        ?.choices
                        ?.[0];

                if (!choice) {

                    throw new Error(
                        "OpenClaw não retornou choices."
                    );

                }

                /*
                 * Registra somente métricas de uso
                 * retornadas pelo OpenClaw.
                 *
                 * Não imprime a resposta inteira.
                 */
                if (
                    data?.usage
                ) {

                    console.log(
                        "[OpenClawProvider][USAGE]",
                        JSON.stringify(
                            data.usage,
                            null,
                            2
                        )
                    );

                }

                console.log(
                    "[OpenClawProvider] 📨 finish_reason:",
                    choice.finish_reason
                );

                /*
                 * Resposta final.
                 */
                if (
                    choice.finish_reason !==
                    "tool_calls"
                ) {

                    console.log(
                        "[OpenClawProvider] ✅ Resposta final recebida."
                    );

                    const text =
                        this.extractContent(
                            data
                        );

                    return {

                        text,

                        media:
                            this.normalizeMedia(
                                media
                            )

                    };

                }

                /*
                 * OpenClaw solicitou Tools.
                 */
                const toolCalls =
                    choice
                        ?.message
                        ?.tool_calls ||
                    [];

                console.log(
                    "[OpenClawProvider] 🔧 Tool calls:",
                    JSON.stringify(
                        toolCalls,
                        null,
                        2
                    )
                );

                if (
                    toolCalls.length === 0
                ) {

                    throw new Error(
                        "OpenClaw informou tool_calls, mas não retornou chamadas."
                    );

                }

                /*
                 * Mensagem assistant contendo
                 * tool_calls entra no histórico
                 * antes das respostas das Tools.
                 */
                conversationMessages.push(
                    choice.message
                );

                for (
                    const toolCall
                    of toolCalls
                ) {

                    const toolName =
                        toolCall
                            ?.function
                            ?.name;

                    const argumentsText =
                        toolCall
                            ?.function
                            ?.arguments ||
                        "{}";

                    const toolCallId =
                        toolCall?.id;

                    console.log(
                        `[OpenClawProvider] 🔧 Executando Tool: ${toolName}`
                    );

                    console.log(
                        `[OpenClawProvider] 📥 Argumentos: ${argumentsText}`
                    );

                    if (!toolName) {

                        console.warn(
                            "[OpenClawProvider] ⚠ Tool call sem nome."
                        );

                        continue;

                    }

                    let argumentsObject;

                    try {

                        argumentsObject =
                            JSON.parse(
                                argumentsText
                            );

                    } catch (error) {

                        const invalidArguments = {

                            error:
                                "Argumentos da Tool não são JSON válidos."

                        };

                        conversationMessages.push({

                            role: "tool",

                            tool_call_id:
                                toolCallId,

                            content:
                                JSON.stringify(
                                    invalidArguments
                                )

                        });

                        continue;

                    }

                    let result;

                    try {

                        result =
                            await ToolManager.execute(

                                toolName,

                                argumentsObject,

                                toolContext

                            );

                        console.log(
                            `[OpenClawProvider] ✅ Tool executada: ${toolName}`
                        );

                        /*
                         * Mantemos por enquanto o resultado
                         * completo no log para diagnóstico
                         * funcional das Tools.
                         *
                         * Posteriormente também poderá ser
                         * resumido/removido.
                         */
                        console.log(
                            `[OpenClawProvider] 📤 Resultado:`,
                            JSON.stringify(
                                result,
                                null,
                                2
                            )
                        );

                        /*
                         * Coleta todas as imagens
                         * encontradas no resultado.
                         */
                        this.collectMedia(
                            result,
                            media
                        );

                    } catch (error) {

                        console.error(
                            `[OpenClawProvider] ❌ Erro na Tool ${toolName}:`,
                            error.message
                        );

                        result = {

                            error:
                                error.message

                        };

                    }

                    /*
                     * Resultado da Tool volta
                     * para o OpenClaw.
                     *
                     * Neste momento ainda é enviado
                     * integralmente.
                     *
                     * Não vamos otimizar este ponto
                     * antes de concluir a medição do
                     * round 0.
                     */
                    conversationMessages.push({

                        role: "tool",

                        tool_call_id:
                            toolCallId,

                        content:
                            this.serializeToolResult(
                                result
                            )

                    });

                }

            } catch (error) {

                throw this.normalizeError(
                    error
                );

            }

        }

        throw new Error(
            `Limite de Tool Calling atingido (${this.maxToolCalls}).`
        );

    }

    async chat(request = {}) {

        return this.generate(
            request
        );

    }

    async stream(request = {}) {

        /*
         * MVP:
         * Tool Calling continua não-streaming.
         */
        return this.generate({

            ...request,

            stream: false

        });

    }

    async health() {

        const response =
            await this.http.get(
                "/models"
            );

        return {

            provider:
                this.name,

            status:
                response.status === 200
                    ? "healthy"
                    : "unhealthy",

            statusCode:
                response.status

        };

    }

    resolveAgentTarget(agent) {

        const agentMap = {

            sales:
                "openclaw/vendas-agent",

            support:
                "openclaw/suporte-agent",

            admin:
                "openclaw/default",

            product:
                "openclaw/default",

            aiData:
                "openclaw/default",

            fallback:
                "openclaw/default"

        };

        return (

            agentMap[agent] ||

            this.agentTarget

        );

    }

    normalizeTools(tools) {

        if (
            !Array.isArray(tools)
        ) {

            return [];

        }

        return tools.filter(
            tool => {

                return (

                    tool &&

                    tool.type ===
                        "function" &&

                    tool.function &&

                    tool.function.name

                );

            }
        );

    }

    buildSessionUser(session) {

        if (!session) {

            return "conv:default";

        }

        const sessionId =
            this.resolveSessionId(
                session
            );

        return (
            `conv:${sessionId}`
        );

    }

    resolveSessionId(session) {

        if (!session) {

            return "default";

        }

        if (
            typeof session ===
            "string"
        ) {

            return session;

        }

        return (

            session.id ||

            session.key ||

            "default"

        );

    }

    serializeToolResult(result) {

        if (
            result === undefined
        ) {

            return JSON.stringify({

                result: null

            });

        }

        if (
            typeof result ===
            "string"
        ) {

            return result;

        }

        try {

            return JSON.stringify(
                result
            );

        } catch (error) {

            return JSON.stringify({

                error:
                    "Resultado da Tool não pôde ser serializado."

            });

        }

    }

    /*
     * Procura imagens recursivamente
     * dentro do retorno das Tools.
     */
    collectMedia(
        value,
        media
    ) {

        if (
            value === null ||
            value === undefined
        ) {

            return;

        }

        if (
            Array.isArray(value)
        ) {

            for (
                const item
                of value
            ) {

                this.collectMedia(
                    item,
                    media
                );

            }

            return;

        }

        if (
            typeof value !==
            "object"
        ) {

            return;

        }

        if (
            Array.isArray(
                value.images
            )
        ) {

            for (
                const image
                of value.images
            ) {

                if (
                    !image ||
                    !image.url
                ) {

                    continue;

                }

                const relativeUrl =
                    String(
                        image.url
                    ).trim();

                if (
                    !relativeUrl.startsWith(
                        "/uploads/"
                    )
                ) {

                    continue;

                }

                /*
                 * Converte:
                 *
                 * /uploads/products/foto.jpg
                 *
                 * em:
                 *
                 * /home/lauro/ai-system-2.0/public/uploads/products/foto.jpg
                 */
                const relativePath =
                    relativeUrl.replace(
                        /^\/+/,
                        ""
                    );

                const absolutePath =
                    path.resolve(
                        this.publicDir,
                        relativePath
                    );

                /*
                 * Evita duplicação.
                 */
                const exists =
                    media.some(
                        item =>
                            item.path ===
                            absolutePath
                    );

                if (
                    exists
                ) {

                    continue;

                }

                media.push({

                    type:
                        "image",

                    path:
                        absolutePath,

                    url:
                        relativeUrl,

                    mimeType:
                        "image/jpeg"

                });

            }

        }

        /*
         * Continua pesquisando objetos
         * aninhados.
         */
        for (
            const [key, child]
            of Object.entries(
                value
            )
        ) {

            if (
                child &&
                typeof child ===
                    "object"
            ) {

                this.collectMedia(
                    child,
                    media
                );

            }

        }

    }

    /*
     * Normaliza mídias antes de devolver
     * ao ChatPipeline.
     */
    normalizeMedia(media) {

        if (
            !Array.isArray(media)
        ) {

            return [];

        }

        return media
            .filter(
                item =>
                    item &&
                    item.type === "image" &&
                    item.path
            )
            .map(
                item => ({

                    type:
                        "image",

                    path:
                        item.path,

                    url:
                        item.url ||
                        null,

                    mimeType:
                        item.mimeType ||
                        "image/jpeg"

                })
            );

    }

    extractContent(data) {

        const content =
            data
                ?.choices
                ?.[0]
                ?.message
                ?.content;

        if (
            content === undefined ||
            content === null
        ) {

            return "";

        }

        return content;

    }

    normalizeError(error) {

        if (error.response) {

            const message =
                error.response.data
                    ?.error
                    ?.message ||
                `OpenClaw HTTP ${error.response.status}`;

            return new Error(
                message
            );

        }

        if (
            error.code ===
            "ECONNREFUSED"
        ) {

            return new Error(
                `Não foi possível conectar ao OpenClaw em ${this.baseUrl}`
            );

        }

        if (
            error.code ===
                "ETIMEDOUT" ||
            error.code ===
                "ECONNABORTED"
        ) {

            return new Error(
                "Timeout ao comunicar com o OpenClaw."
            );

        }

        return error;

    }

}

module.exports =
    OpenClawProvider;
