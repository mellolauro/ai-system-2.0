datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ==========================================
// MULTI-TENANCY & AGENTES
// ==========================================

model Tenant {
  id        String  @id @default(cuid())
  name      String
  plan      String  @default("free")
  maxTokens Int     @default(50000)
  active    Boolean @default(true)
  agentName String

  users            User[]
  products         Product[]
  orders           Order[]
  tools            Tool[]
  whatsappSessions WhatsAppSession[]
  conversations    Conversation[]
  carts            Cart[]

  createdAt DateTime @default(now())

  @@index([active])
}

// ==========================================
// USUÁRIOS & SESSÕES DE ATENDIMENTO
// ==========================================

model User {
  id         String   @id @default(cuid())
  telegramId String?  @unique
  phone      String?  @unique
  email      String?
  name       String
  avatarUrl  String?  // <--- Guarda a URL da imagem (ex: "https://site.com/foto.jpg")
  role       UserRole @default(USER)

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  orders        Order[]
  memories      UserMemory[]
  carts         Cart[]
  conversations Conversation[]

  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([phone])
  @@index([tenantId, role])
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  key       String
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String

  user      User      @relation(fields: [userId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  messages  Message[]

  createdAt DateTime  @default(now())

  @@index([userId, tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role           String       // user | assistant | system
  content        String

  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  phone     String
  sessionId String

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

// ==========================================
// CATÁLOGO DE PRODUTOS
// ==========================================

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int            @default(0)
  imageUrl    String?
  active      Boolean        @default(true)

  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])

  images      ProductImage[]
  orderItems  OrderItem[]
  cartItems   CartItem[]

  createdAt   DateTime       @default(now())

  @@index([tenantId, active])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// ==========================================
// CARRINHO DE COMPRAS
// ==========================================

model Cart {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String

  user      User       @relation(fields: [userId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])

  status    String     @default("active")

  items     CartItem[]

  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@index([userId, status])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int

  @@index([cartId])
}

// ==========================================
// PEDIDOS & LOGÍSTICA
// ==========================================

model Order {
  id            String        @id @default(cuid())

  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  userId        String
  user          User          @relation(fields: [userId], references: [id])

  status        OrderStatus   @default(PENDING)
  cancelReason  String?     // Observação do cancelamento (opcional, texto curto)
  hidden        Boolean     @default(false) // Define se fica oculto na listagem
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  total         Float

  trackingCode  String?
  carrier       String?

  paidAt        DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  items         OrderItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([trackingCode])
}

model OrderItem {
  id          String  @id @default(cuid())

  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])

  productId   String
  product     Product @relation(fields: [productId], references: [id])

  productName String?
  quantity    Int
  price       Float

  @@index([orderId])
}

// ==========================================
// MOTOR DE IA & TOOLS
// ==========================================

model Tool {
  id        String   @id @default(cuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  type      String   // api | internal | webhook
  config    Json

  active    Boolean  @default(true)

  createdAt DateTime @default(now())

  @@index([tenantId, active])
}

model AIRequest {
  id        String   @id @default(cuid())

  tenantId  String
  userId    String?

  prompt    String
  response  String?

  tokens    Int?
  agent     String

  createdAt DateTime @default(now())

  @@index([tenantId])
}
